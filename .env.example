# Admin credentials for the bookmarks API.
#
# These were hardcoded in app/api/bookmarks/route.ts, which put the password
# in git history on a public repository. Treat the old password as
# compromised, choose a new one here, and set the same values in the
# environment on the VPS — the API route throws on boot if either is missing,
# so a deploy without them fails loudly rather than opening the panel.
ADMIN_USER=your-username
ADMIN_PASS=choose-a-long-unique-password

# Spotify, for the now-playing surface. Optional: the component degrades to
# "NO SIGNAL" when these are absent.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# ---------------------------------------------------------------------------
# SEO / measurement
# ---------------------------------------------------------------------------
# All optional. With every one of these unset the site builds and runs exactly
# as before — nothing below fails a deploy or logs an error when missing.

# Canonical origin. Used by metadataBase, the sitemap, RSS, JSON-LD and every
# OG URL, so it is the one value that decides which domain the site claims to be.
# Defaults to https://adityahimaone.space when unset.
#
# Set this for staging/preview builds: without it a preview serves production
# canonicals, which tells the index a preview URL is a duplicate of the real one.
# NEXT_PUBLIC_SITE_URL=https://adityahimaone.space

# GA4 measurement id, e.g. G-ABC1234XYZ. When unset, no analytics script is
# emitted at all — an empty id would load gtag.js for a property that can never
# report anything. Get it from GA4 > Admin > Data Streams > Web.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Search Console verification token (the `content=` value of the meta tag
# Search Console offers under Settings > Ownership verification). Unlocks the
# index/impression/CTR data that docs/seo-audit.md currently cannot check.
# NEXT_PUBLIC_GSC_VERIFICATION=
