@@ -0,0 +1,38 @@
+# Contact: the session desk
+
+The 16-pad performance controller is unchanged (its GSAP coupling, its audio
+indices and its sweep order are untouched). Everything around it is rebuilt as
+the rest of one desk, in the About devices' materials (cream glass shell, dark
+rim, near-black LCD, dark pads that light orange).
+
+## What changed
+
+| Before | After |
+| --- | --- |
+| Header + paragraph | Same heading, plus a **status strip**: channel open, reply time, live Jakarta clock |
+| FAQ accordion (4 questions) | **Recall console**: five mixer channel strips driving an LCD monitor that types the answer out |
+| nothing | **Signal path**: how a project flows (brief, scope, build, hand off) as patched stages with animated cables |
+| nothing | **Brief builder**: pick the kind of work and timing, add a line, and it composes the email (`mailto:` link, plus copy) |
+
+## Decisions
+
+- **Accessible by construction.** The console is a real tabs pattern (tablist,
+  tabpanel, arrow keys, Home/End, roving tabindex). The full answer is real text
+  in the panel; the typed copy is `aria-hidden`, so a screen reader never hears
+  half a sentence. The path is an ordered list. Reduced motion prints the answer
+  whole and stills the meters and cables.
+- **Works without JavaScript.** Server markup is fully visible (`data-reveal="idle"`);
+  elements only hide once a script has armed them. The brief builder's link is a
+  working `mailto:` on first paint.
+- **Nothing is sent anywhere.** No form endpoint, no stored text.
+- **The mailto is capped by its encoded length** (1900), not the typed length:
+  a note of 480 non-ASCII characters encodes to ~4000 and Outlook-class clients
+  refuse past ~2000. The tests caught this.
+- **Copy** is deliberately modest and checkable: no rate, no dated availability,
+  no client list; the honest "no" on native mobile is kept. Edit
+  `contact-desk/contact-content.ts` to change any of it.
+- The desk sits between `.contactDeck` and the footer, because the rack's scroll
+  animation addresses children of `.contactDeck` by class.
+
+The old `.contactBrief*` rules in `rack-01.module.css` are no longer used and can
+be deleted.
diff --git a/features/landing-page/rack-01/contact-desk/contact-brief-builder.tsx b/features/landing-page/rack-01/contact-desk/contact-brief-builder.tsx
new file mode 100644
index 0000000..da33b88
--- /dev/null
+++ b/features/landing-page/rack-01/contact-desk/contact-brief-builder.tsx
@@ -0,0 +1,164 @@
+'use client'
+
+import { useId, useMemo, useState } from 'react'
+import {
+  NOTE_LIMIT,
+  PROJECT_TYPES,
+  TIMELINES,
+  composeBrief,
+} from './contact-content'
+import styles from './contact-desk.module.css'
+import { useReveal } from './use-reveal'
+
+type Copy = 'idle' | 'copied' | 'failed'
+
+/**
+ * The brief builder: a few controls that compose the first email.
+ *
+ * The controller above is the way in; this is what people usually need once
+ * they are in, which is something to say. Pick the kind of work and the timing,
+ * add a line, and the LCD shows the message exactly as it will arrive. "Open in
+ * mail" is a plain `mailto:` link, so it works without a script and in any mail
+ * client; "Copy" is there for the people who live in a web mail tab.
+ *
+ * Nothing is sent anywhere by this page. There is no form endpoint and no
+ * stored note: the text exists in this component and in the link.
+ */
+export function ContactBriefBuilder({ email }: { email: string }) {
+  const [type, setType] = useState<string | null>(null)
+  const [timeline, setTimeline] = useState<string | null>(null)
+  const [note, setNote] = useState('')
+  const [copy, setCopy] = useState<Copy>('idle')
+  const [reveal, revealState] = useReveal<HTMLElement>()
+  const id = useId()
+
+  const brief = useMemo(
+    () => composeBrief({ type, timeline, note }, email),
+    [type, timeline, note, email],
+  )
+  const timelinePos = TIMELINES.findIndex((t) => t.id === timeline)
+
+  const copyBrief = async () => {
+    try {
+      await navigator.clipboard.writeText(
+        `To: ${email}\nSubject: ${brief.subject}\n\n${brief.body}`,
+      )
+      setCopy('copied')
+    } catch {
+      setCopy('failed')
+    }
+    window.setTimeout(() => setCopy('idle'), 2200)
+  }
+
+  return (
+    <section
+      ref={reveal}
+      data-reveal={revealState}
+      className={`${styles.panel} ${styles.builder}`}
+      aria-labelledby={`${id}-title`}
+    >
+      <header className={styles.panelHead}>
+        <div>
+          <strong>AH / BRIEF</strong>
+          <span>Compose the first message</span>
+        </div>
+        <h3 id={`${id}-title`}>Brief builder</h3>
+        <small>mailto</small>
+      </header>
+
+      <div className={styles.builderBody}>
+        <div className={styles.controls}>
+          <fieldset className={styles.field}>
+            <legend>Kind of work</legend>
+            <div className={styles.typePads}>
+              {PROJECT_TYPES.map((choice) => (
+                <button
+                  key={choice.id}
+                  type="button"
+                  className={styles.typePad}
+                  aria-pressed={type === choice.id}
+                  onClick={() => setType(type === choice.id ? null : choice.id)}
+                >
+                  {choice.label}
+                </button>
+              ))}
+            </div>
+          </fieldset>
+
+          <fieldset className={styles.field}>
+            <legend>Timing</legend>
+            <div
+              className={styles.switch}
+              data-has={timelinePos >= 0}
+              style={
+                { '--pos': Math.max(0, timelinePos) } as React.CSSProperties
+              }
+            >
+              <span className={styles.switchThumb} aria-hidden="true" />
+              {TIMELINES.map((choice) => (
+                <button
+                  key={choice.id}
+                  type="button"
+                  aria-pressed={timeline === choice.id}
+                  onClick={() =>
+                    setTimeline(timeline === choice.id ? null : choice.id)
+                  }
+                >
+                  {choice.label}
+                </button>
+              ))}
+            </div>
+          </fieldset>
+
+          <div className={styles.field}>
+            <label htmlFor={`${id}-note`} className={styles.fieldLabel}>
+              One line about it
+            </label>
+            <textarea
+              id={`${id}-note`}
+              className={styles.note}
+              rows={3}
+              maxLength={NOTE_LIMIT}
+              value={note}
+              placeholder="What is it, and what is the hard part?"
+              onChange={(event) => setNote(event.target.value)}
+            />
+            <small className={styles.count}>
+              {note.length}/{NOTE_LIMIT}
+            </small>
+          </div>
+        </div>
+
+        <div className={styles.output}>
+          <pre
+            className={styles.lcd}
+            aria-live="polite"
+            aria-label="Message preview"
+          >
+            <span>TO&nbsp;&nbsp;&nbsp;&nbsp;{email}</span>
+            {'\n'}
+            <span>SUBJ&nbsp;&nbsp;{brief.subject}</span>
+            {'\n\n'}
+            {brief.body}
+          </pre>
+          <div className={styles.actions}>
+            <a className={styles.send} href={brief.href}>
+              Open in mail
+            </a>
+            <button
+              type="button"
+              className={styles.copyKey}
+              onClick={copyBrief}
+            >
+              {copy === 'copied'
+                ? 'Copied'
+                : copy === 'failed'
+                  ? 'Select the text'
+                  : 'Copy brief'}
+            </button>
+          </div>
+        </div>
+      </div>
+    </section>
+  )
+}
diff --git a/features/landing-page/rack-01/contact-desk/contact-console.tsx b/features/landing-page/rack-01/contact-desk/contact-console.tsx
new file mode 100644
index 0000000..8916c70
--- /dev/null
+++ b/features/landing-page/rack-01/contact-desk/contact-console.tsx
@@ -0,0 +1,152 @@
+'use client'
+
+import { useEffect, useId, useRef, useState } from 'react'
+import { CHANNELS, nextChannel, typedSlice } from './contact-content'
+import styles from './contact-desk.module.css'
+import { useReveal } from './use-reveal'
+
+/** Heights of the monitor's spectrum, fixed so the picture is the same twice. */
+const SPECTRUM = Array.from({ length: 30 }, (_, i) =>
+  Math.round(24 + 60 * Math.abs(Math.sin(i * 0.83) * Math.cos(i * 0.31))),
+)
+
+/**
+ * The recall console: the old FAQ, rebuilt as a mixer.
+ *
+ * Each question is a channel strip, and selecting one plays its answer on the
+ * monitor, typed out the way the controller's own LCD prints. It is a tabs
+ * pattern underneath (one tablist, one panel, arrow keys, roving tabindex) so
+ * it is exactly as operable by keyboard and screen reader as the accordion it
+ * replaces: the panel carries the full answer as real text, and the typed copy
+ * is `aria-hidden`, so a screen reader never hears half a sentence.
+ */
+export function ContactConsole() {
+  const [active, setActive] = useState(0)
+  const [reveal, revealState] = useReveal<HTMLElement>()
+  const typed = useRef<HTMLSpanElement | null>(null)
+  const tabs = useRef<(HTMLButtonElement | null)[]>([])
+  const id = useId()
+  const channel = CHANNELS[active]
+
+  // Type the answer. Written to a node, not to state, so sixty frames of
+  // typing are sixty text writes and no renders. Reduced motion prints it whole.
+  useEffect(() => {
+    const node = typed.current
+    if (!node) return
+    const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches
+    if (still) {
+      node.textContent = channel.answer
+      return
+    }
+    const duration = Math.min(1500, Math.max(520, channel.answer.length * 9))
+    const start = performance.now()
+    let raf = 0
+    const frame = (now: number) => {
+      const t = Math.min(1, (now - start) / duration)
+      node.textContent = typedSlice(channel.answer, t)
+      if (t < 1) raf = requestAnimationFrame(frame)
+    }
+    node.textContent = ''
+    raf = requestAnimationFrame(frame)
+    return () => cancelAnimationFrame(raf)
+  }, [channel])
+
+  const onKeyDown = (event: React.KeyboardEvent, index: number) => {
+    const next = nextChannel(event.key, index, CHANNELS.length)
+    if (next === null) return
+    event.preventDefault()
+    setActive(next)
+    tabs.current[next]?.focus()
+  }
+
+  return (
+    <section
+      ref={reveal}
+      data-reveal={revealState}
+      className={`${styles.panel} ${styles.console}`}
+      aria-labelledby={`${id}-title`}
+    >
+      <header className={styles.panelHead}>
+        <div>
+          <strong>AH / RECALL</strong>
+          <span>Printed insert · five channels</span>
+        </div>
+        <h3 id={`${id}-title`}>Before you write</h3>
+        <small>
+          CH {String(active + 1).padStart(2, '0')}/
+          {String(CHANNELS.length).padStart(2, '0')}
+        </small>
+      </header>
+
+      <div className={styles.consoleBody}>
+        <div
+          role="tablist"
+          aria-label="Questions"
+          aria-orientation="vertical"
+          className={styles.strips}
+        >
+          {CHANNELS.map((item, index) => (
+            <button
+              key={item.tag}
+              ref={(node) => {
+                tabs.current[index] = node
+              }}
+              id={`${id}-tab-${index}`}
+              type="button"
+              role="tab"
+              aria-selected={index === active}
+              aria-controls={`${id}-panel`}
+              tabIndex={index === active ? 0 : -1}
+              className={styles.strip}
+              onClick={() => setActive(index)}
+              onKeyDown={(event) => onKeyDown(event, index)}
+            >
+              <span className={styles.stripNum}>
+                {String(index + 1).padStart(2, '0')}
+              </span>
+              <span className={styles.stripTag}>{item.tag}</span>
+              <span className={styles.stripMeter} aria-hidden="true">
+                {[0, 1, 2, 3, 4].map((led) => (
+                  <i
+                    key={led}
+                    style={{ '--led': led } as React.CSSProperties}
+                  />
+                ))}
+              </span>
+            </button>
+          ))}
+        </div>
+
+        <div
+          role="tabpanel"
+          id={`${id}-panel`}
+          aria-labelledby={`${id}-tab-${active}`}
+          className={styles.monitor}
+        >
+          <div className={styles.monitorTop} aria-hidden="true">
+            <span>
+              CH {String(active + 1).padStart(2, '0')} · {channel.tag}
+            </span>
+            <span className={styles.play}>PLAY</span>
+          </div>
+          <h4 className={styles.monitorQuestion}>{channel.question}</h4>
+          {/* The whole answer, as text, for everything that is not looking at
+              the typed copy. */}
+          <p className={styles.srOnly}>{channel.answer}</p>
+          <p className={styles.monitorAnswer} aria-hidden="true">
+            <span ref={typed} />
+            <span className={styles.caret} />
+          </p>
+          <div className={styles.spectrum} aria-hidden="true">
+            {SPECTRUM.map((h, i) => (
+              <i
+                key={i}
+                style={{ '--h': `${h}%`, '--i': i } as React.CSSProperties}
+              />
+            ))}
+          </div>
+        </div>
+      </div>
+    </section>
+  )
+}
diff --git a/features/landing-page/rack-01/contact-desk/contact-content.ts b/features/landing-page/rack-01/contact-desk/contact-content.ts
new file mode 100644
index 0000000..77d64b5
--- /dev/null
+++ b/features/landing-page/rack-01/contact-desk/contact-content.ts
@@ -0,0 +1,200 @@
+/**
+ * What the Contact section says, and the small pieces of logic behind how it
+ * says it. No React, no DOM, so all of it is testable.
+ *
+ * The performance controller (the 16-pad deck) is untouched and is still the
+ * way in. Everything *around* it is rebuilt as the rest of one session desk:
+ *
+ * - a **recall console** (the old FAQ): five channels, each a question, and an
+ *   LCD monitor that plays the answer;
+ * - a **signal path**: how a project actually flows, as four patched stages;
+ * - a **brief builder**: pick the kind of work and the timing, add a line, and
+ *   it composes the email for you.
+ *
+ * Copy is written to be useful and checkable. There is no availability claim
+ * with a date on it, no rate, no client list: the only promise is the one the
+ * old page already made (replies usually land within a couple of days), and the
+ * "no" on native mobile is kept, because a no saves both people a week.
+ */
+
+export type Channel = {
+  /** Silkscreen label on the strip. */
+  tag: string
+  question: string
+  answer: string
+}
+
+export const CHANNELS: readonly Channel[] = [
+  {
+    tag: 'SCOPE',
+    question: 'What kind of work do you take on?',
+    answer:
+      'Frontend work where the hard part is the state or the edge cases rather than the styling: internal tools, content-heavy public sites, and products that have to work on a phone or on a bad connection.',
+  },
+  {
+    tag: 'BACKEND',
+    question: 'Do you work with existing backends?',
+    answer:
+      'Mostly. Most of the shipped work is a frontend over a service that already exists. Running the infrastructure too is something I do when the product genuinely needs it.',
+  },
+  {
+    tag: 'MOBILE',
+    question: 'Do you do React Native or native mobile?',
+    answer:
+      'No. The mobile work here is responsive web. The habits transfer, the stack does not, and I would rather say so now than take it and hand it back.',
+  },
+  {
+    tag: 'REPLY',
+    question: 'How fast do you reply?',
+    answer:
+      'Usually within a couple of days. If there is a date that matters, put it in the first line so it is the first thing I read.',
+  },
+  {
+    tag: 'FIRST MAIL',
+    question: 'What should the first message say?',
+    answer:
+      'The problem, who it is for, and the constraint that hurts: a date, a budget, a stack you cannot change. A link helps if there is one. Two paragraphs beat a deck.',
+  },
+]
+
+export type Stage = { step: string; title: string; copy: string }
+
+/** The signal path: input to output, left to right. */
+export const PATH: readonly Stage[] = [
+  {
+    step: 'IN',
+    title: 'Brief',
+    copy: 'You send the problem, the constraint and the date. I read it properly, not in a queue.',
+  },
+  {
+    step: '01',
+    title: 'Scope',
+    copy: 'I reply with the questions that change the plan, and a plan small enough to disagree with.',
+  },
+  {
+    step: '02',
+    title: 'Build',
+    copy: 'Small increments, a working build you can click at every step instead of a deck about one.',
+  },
+  {
+    step: 'OUT',
+    title: 'Hand off',
+    copy: 'Code someone else can run, tests where they earn their keep, and notes that outlive the project.',
+  },
+]
+
+export type Choice = { id: string; label: string; line: string }
+
+export const PROJECT_TYPES: readonly Choice[] = [
+  { id: 'build', label: 'New build', line: 'a new frontend build' },
+  { id: 'rescue', label: 'Fix a UI', line: 'a frontend that needs untangling' },
+  { id: 'design', label: 'Design eng.', line: 'design engineering work' },
+  { id: 'talk', label: 'Just talk', line: 'a conversation about a problem' },
+]
+
+export const TIMELINES: readonly Choice[] = [
+  { id: 'soon', label: 'Soon', line: 'as soon as possible' },
+  { id: 'month', label: 'This quarter', line: 'within the next few months' },
+  { id: 'open', label: 'No rush', line: 'with no fixed date' },
+]
+
+export const NOTE_LIMIT = 480
+
+/** The longest `mailto:` link composed. Outlook-class clients refuse past ~2000. */
+export const MAX_HREF = 1900
+
+export type BriefInput = {
+  type: string | null
+  timeline: string | null
+  note: string
+}
+
+export type Brief = { subject: string; body: string; href: string }
+
+const find = (list: readonly Choice[], id: string | null) =>
+  list.find((choice) => choice.id === id) ?? null
+
+/** Collapse whitespace runs and cap the length, so a pasted wall of text cannot
+ * produce a `mailto:` link too long for a mail client to open. */
+export function cleanNote(note: string, limit = NOTE_LIMIT): string {
+  const flat = note
+    .replace(/\r\n?/g, '\n')
+    .replace(/[ \t]+/g, ' ')
+    .trim()
+  return flat.length > limit ? `${flat.slice(0, limit - 1).trimEnd()}…` : flat
+}
+
+/**
+ * The email the builder composes. Pure: the same input is the same brief.
+ *
+ * Nothing selected is still a valid brief ("a frontend project"), so the
+ * Compose button is never dead; picking things only makes it more specific.
+ */
+export function composeBrief(input: BriefInput, to: string): Brief {
+  const type = find(PROJECT_TYPES, input.type)
+  const timeline = find(TIMELINES, input.timeline)
+
+  const subject = type
+    ? `Brief: ${type.label.toLowerCase()}`
+    : 'Brief: a frontend project'
+
+  const build = (note: string) => {
+    const lines = [
+      'Hi Aditya,',
+      '',
+      `I am looking for ${type ? type.line : 'help with a frontend project'}${
+        timeline ? `, ${timeline.line}` : ''
+      }.`,
+    ]
+    if (note) lines.push('', 'About it:', note)
+    lines.push('', 'Thanks,')
+    const body = lines.join('\n')
+    const href = `mailto:${to}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`
+    return { subject, body, href }
+  }
+
+  // The cap that matters is on the *encoded* link, not the typed note: a
+  // character outside ASCII becomes up to nine characters of percent-escapes,
+  // so a note well under `NOTE_LIMIT` can still make a link some mail clients
+  // refuse to open. Shrink the note, not the browser's patience.
+  let note = cleanNote(input.note)
+  let brief = build(note)
+  while (brief.href.length > MAX_HREF && note.length > 0) {
+    note = cleanNote(note, Math.floor(note.length * 0.85))
+    brief = build(note)
+  }
+  return brief
+}
+
+/** The first `progress` (0–1) of `text`, for the monitor's typed answer. */
+export function typedSlice(text: string, progress: number): string {
+  const p = Number.isFinite(progress) ? Math.min(1, Math.max(0, progress)) : 0
+  return text.slice(0, Math.round(text.length * p))
+}
+
+/**
+ * The next channel for a key press on the strip list, or `null` for a key that
+ * is not navigation. Arrow keys wrap, Home and End jump; both axes work because
+ * the strips are a column on desktop and a grid on a phone.
+ */
+export function nextChannel(
+  key: string,
+  index: number,
+  count: number,
+): number | null {
+  if (count <= 0) return null
+  switch (key) {
+    case 'ArrowDown':
+    case 'ArrowRight':
+      return (index + 1) % count
+    case 'ArrowUp':
+    case 'ArrowLeft':
+      return (index - 1 + count) % count
+    case 'Home':
+      return 0
+    case 'End':
+      return count - 1
+    default:
+      return null
+  }
+}
