+
+/* ═══ Deck theme ═════════════════════════════════════════════════════════════
+   Everything below is the last word on colour, face, corner and material. It
+   restates nothing about size or position, so no layout moves.
+
+   The tokens live in app/deck-theme.css and are read off the hero's DAW and
+   the About section's glass hardware. The rack's own palette is re-pointed at
+   them here, then the two devices that used to look like different products
+   (the Skills controller, the Experience radio) are re-skinned in the About
+   device's language: a frosted cream shell with a dark rim, an opaque chassis
+   inside it, near-black LCDs, dark pads that light orange.
+
+   It is last in the file on purpose. Earlier blocks restate the same rules for
+   breakpoints; equal specificity plus source order is what lets this one win
+   at every size without `!important`. */
+
+.root,
+:global(.dark) .root {
+  --chassis: var(--deck-paper);
+  --chassis-hi: var(--deck-paper-hi);
+  --graphite: var(--deck-ground-2);
+  --lcd-black: var(--deck-lcd-fill);
+  --signal-orange: var(--deck-orange);
+  --field-navy: var(--deck-navy);
+  --lcd-green: var(--deck-lcd-green);
+  --room-base: var(--deck-ground);
+  --room-ink: var(--deck-ground-ink);
+  --band-tan: var(--deck-paper);
+  --band-tan-wash: var(--deck-wash);
+  --panel-ink: var(--deck-paper-ink);
+  --panel-ink-muted: var(--deck-paper-muted);
+  --label-ink: var(--deck-paper-muted);
+  --band-grid-line: var(--deck-paper-grid);
+  --dev-accent: var(--deck-orange);
+  --dev-amber: var(--deck-amber);
+  font-family: var(--deck-font-ui);
+}
+:global(.dark) .root {
+  --band-tan: var(--deck-ground);
+}
+
+/* One ground. The hero, the skills room and the work booth were three
+   charcoals; the page behind them is the hero's. */
+.root {
+  background:
+    linear-gradient(90deg, var(--deck-grid-line) 1px, transparent 1px) 0 0 /
+      var(--deck-grid-cell) var(--deck-grid-cell),
+    var(--deck-ground);
+}
+
+/* ── Skills: the room ── */
+.skills {
+  background:
+    radial-gradient(
+      70% 46% at 50% 0%,
+      color-mix(in srgb, var(--deck-orange) 9%, transparent),
+      transparent 72%
+    ),
+    linear-gradient(90deg, var(--deck-grid-line) 1px, transparent 1px) 0 0 /
+      var(--deck-grid-cell) var(--deck-grid-cell),
+    linear-gradient(0deg, var(--deck-grid-line) 1px, transparent 1px) 0 0 /
+      var(--deck-grid-cell) var(--deck-grid-cell),
+    var(--deck-ground);
+}
+.skillsIntro > p {
+  color: var(--deck-ground-muted);
+}
+
+/* ── The shell: one recipe for every device on the page ── */
+.controller,
+.experience .radioFace {
+  border: 1px solid var(--deck-shell-edge);
+  border-radius: var(--deck-r-shell);
+  background: var(--deck-shell-fill);
+  background-color: var(--deck-paper-lo);
+  box-shadow: var(--deck-shell-hi), var(--deck-shell-lo),
+    var(--deck-shell-shadow);
+  backdrop-filter: none;
+  -webkit-backdrop-filter: none;
+  color: var(--deck-cream-ink);
+}
+.experience .radioFace {
+  /* The radio floats over paper rather than the dark room, so its drop is the
+     lighter one the About devices cast. */
+  box-shadow: var(--deck-shell-hi), var(--deck-shell-lo),
+    0 18px 40px -22px rgb(0 0 0 / 0.5), 0 2px 4px rgb(0 0 0 / 0.16);
+}
+
+/* The chassis inside the shell. */
+.controllerTopbar {
+  border-bottom-color: rgb(27 28 26 / 0.22);
+}
+.controlBank + .controlBank {
+  border-left-color: rgb(27 28 26 / 0.2);
+}
+.keyboardBed,
+.experience .radioSpeaker,
+.experience .radioTuner,
+.experience .radioDials {
+  border: 1px solid rgb(27 28 26 / 0.26);
+  border-radius: var(--deck-r-inner);
+  background: var(--deck-chassis-fill);
+  box-shadow: var(--deck-shell-hi), var(--deck-shell-lo);
+  backdrop-filter: none;
+  -webkit-backdrop-filter: none;
+}
+.experience .radioSpeakerBadge {
+  border-radius: var(--deck-r-chip);
+  background: var(--deck-lcd-fill);
+  color: var(--deck-lcd-peach);
+  box-shadow: none;
+  backdrop-filter: none;
+  -webkit-backdrop-filter: none;
+}
+
+/* ── Screens: near-black glass, mono type ── */
+.controllerDisplay,
+.experience .radioLevel,
+.experience .frequencyDisplay,
+.experience .frequencyScale {
+  border: 2px solid var(--deck-lcd-edge);
+  border-radius: var(--deck-r-lcd);
+  background-color: var(--deck-lcd-fill);
+  box-shadow: var(--deck-lcd-glow);
+  backdrop-filter: none;
+  -webkit-backdrop-filter: none;
+  font-family: var(--deck-font-mono);
+}
+.experience .frequencyDisplay {
+  font-family: var(--deck-font-readout);
+  color: var(--deck-lcd-peach);
+}
+.experience .radioLevel i {
+  box-shadow: 0 0 5px color-mix(in srgb, var(--deck-lcd-green) 30%, transparent);
+}
+.experience .radioLevel i:nth-child(3n) {
+  box-shadow: 0 0 5px color-mix(in srgb, var(--deck-orange) 34%, transparent);
+}
+
+/* ── Pads and keys: dark caps that light orange ── */
+.padBank button {
+  border-color: var(--deck-pad-edge);
+  border-radius: var(--deck-r-key);
+  background: var(--deck-pad-fill);
+}
+.padBank button:hover {
+  border-color: var(--deck-orange);
+}
+.padBank button.padActive {
+  background: var(--deck-pad-lit) !important;
+  border-color: var(--deck-orange) !important;
+}
+.whiteKeys button,
+.blackKeys button {
+  border-radius: 1px 1px var(--deck-r-key) var(--deck-r-key);
+}
+
+/* ── Radio dials: the same brushed knob the sampler wears ── */
+.experience .radioDials span > i {
+  border-color: rgb(255 255 255 / 0.5);
+  background:
+    linear-gradient(
+      90deg,
+      transparent 48%,
+      var(--deck-orange) 48% 52%,
+      transparent 52%
+    ),
+    radial-gradient(circle at 32% 22%, #f0ede6, #b9b5aa 70%, #8d8a82);
+  box-shadow: 0 1px 3px rgb(0 0 0 / 0.4), var(--deck-shell-hi);
+}
+
+/* ── Selector chips: the key recipe, in cream ── */
+.experience .experienceSelector button {
+  border: 1px solid rgb(27 28 26 / 0.3);
+  border-radius: var(--deck-r-inner);
+  background: var(--deck-chassis-fill);
+  box-shadow: var(--deck-shell-hi), var(--deck-shell-lo);
+  backdrop-filter: none;
+  -webkit-backdrop-filter: none;
+  color: var(--deck-cream-ink);
+}
+.experience .experienceSelector button:hover,
+.experience .experienceSelector button[aria-selected='true'] {
+  border-color: var(--deck-orange);
+}
+
+/* ── Experience: paper, not tan ──
+   The band is the same graph paper the About sheet is drawn on, so the page
+   reads as one surface from About to Contact. The wash is orange stage light
+   where it used to be wine. */
+.experience {
+  background:
+    radial-gradient(circle at 14% 22%, var(--deck-wash), transparent 28%),
+    linear-gradient(90deg, var(--deck-paper-grid) 1px, transparent 1px) 0 0 /
+      var(--deck-grid-cell) var(--deck-grid-cell),
+    linear-gradient(0deg, var(--deck-paper-grid) 1px, transparent 1px) 0 0 /
+      var(--deck-grid-cell) var(--deck-grid-cell),
+    var(--band-tan);
+}
+.cableDivider {
+  background:
+    linear-gradient(90deg, var(--deck-paper-grid) 1px, transparent 1px) 0 0 /
+      var(--deck-grid-cell) var(--deck-grid-cell),
+    var(--band-tan);
+}
+
+/* ── Contact: same chassis as everything else ── */
+.contact .contactLaunchpad,
+.contact .contactDeck {
+  border-radius: var(--deck-r-shell);
+}
+.contact .contactPad {
+  border-radius: var(--deck-r-key);
+}
