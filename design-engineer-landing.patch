+'use client'
+
+import dynamic from 'next/dynamic'
+import { motion, useSpring, useTransform } from 'motion/react'
+import type { MotionValue } from 'motion/react'
+import { ArrowDown } from 'lucide-react'
+import { EASE_OUT } from '@/lib/ease'
+
+// The WebGL bundle is its own chunk and never runs on the server.
+const KnobScene = dynamic(() => import('./knob-scene'), {
+  ssr: false,
+  loading: () => null,
+})
+
+type Props = {
+  progress: MotionValue<number>
+  energy: MotionValue<number>
+  scrollY: MotionValue<number>
+  reduced: boolean
+  onJump: (id: string) => void
+}
+
+const TICKS = Array.from({ length: 81 }, (_, i) => i)
+
+export function StudioHero({
+  progress,
+  energy,
+  scrollY,
+  reduced,
+  onJump,
+}: Props) {
+  // The ruler slides against the scroll with spring lag, so it reads as
+  // something being scrubbed rather than something being scrolled.
+  const rulerX = useSpring(
+    useTransform(scrollY, (y) => -y * 0.35),
+    { stiffness: 120, damping: 24, mass: 0.6 },
+  )
+
+  return (
+    <section
+      id="intro"
+      className="relative flex min-h-[100svh] flex-col justify-between overflow-hidden px-5 pt-28 pb-8 sm:px-10"
+    >
+      <div className="relative z-10 grid flex-1 items-center gap-6 lg:grid-cols-[1.1fr_0.9fr]">
+        <div>
+          <motion.p
+            initial={reduced ? false : { opacity: 0, y: 12 }}
+            animate={{ opacity: 1, y: 0 }}
