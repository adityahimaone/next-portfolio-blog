@@ -0,0 +1,148 @@
+'use client'
+
+import {
+  useReducedMotion,
+  useScroll,
+  useSpring,
+  useTransform,
+  useVelocity,
+} from 'motion/react'
+import { useCallback, useEffect, useRef, useState } from 'react'
+import { EndOfTrack } from './end-of-track'
+import { SelectedTracks } from './selected-tracks'
+import { StudioHero } from './studio-hero'
+import { Stems } from './stems'
+import { BASE_BPM, CHAPTERS } from './studio-data'
+import { Transport } from './transport'
+
+/** Auto-scroll speed at the base tempo, in px per second. */
+const PLAY_SPEED = 140
+
+function clamp(v: number, lo: number, hi: number) {
+  return Math.min(hi, Math.max(lo, v))
+}
+
+/**
+ * The landing page as one track. Scroll is the playhead: the transport shows
+ * where it is, the hero knob turns with it, and scroll speed is the tempo.
+ */
+export default function Studio() {
+  const reduced = useReducedMotion() ?? false
+  const { scrollY, scrollYProgress } = useScroll()
+  const progress = useSpring(scrollYProgress, {
+    stiffness: 140,
+    damping: 26,
+    mass: 0.5,
+  })
+  const velocity = useVelocity(scrollY)
+  const bpm = useSpring(
+    useTransform(velocity, (v) => BASE_BPM + clamp(v / 80, -24, 24)),
+    { stiffness: 90, damping: 18 },
+  )
+  const energy = useTransform(velocity, (v) => clamp(Math.abs(v) / 1800, 0, 1))
+
+  const [marks, setMarks] = useState<readonly number[]>([0, 0.25, 0.5, 1])
+  const [playing, setPlaying] = useState(false)
+  const [loop, setLoop] = useState(false)
+  const loopRef = useRef(loop)
+  useEffect(() => {
+    loopRef.current = loop
+  }, [loop])
+
+  // Chapter markers sit where their sections actually are.
+  useEffect(() => {
+    const measure = () => {
+      const max = document.documentElement.scrollHeight - window.innerHeight
+      if (max <= 0) return
+      setMarks(
+        CHAPTERS.map((chapter) => {
+          const el = document.getElementById(chapter.id)
+          return el
+            ? clamp(
+                (el.getBoundingClientRect().top + window.scrollY) / max,
+                0,
+                1,
+              )
+            : 0
+        }),
+      )
+    }
+    measure()
+    const ro = new ResizeObserver(measure)
+    ro.observe(document.body)
+    return () => ro.disconnect()
+  }, [])
+
+  const jump = useCallback(
+    (id: string) => {
+      document.getElementById(id)?.scrollIntoView({
+        behavior: reduced ? 'auto' : 'smooth',
+        block: 'start',
+      })
+    },
+    [reduced],
+  )
+
+  const replay = useCallback(() => {
+    window.scrollTo({ top: 0, behavior: reduced ? 'auto' : 'smooth' })
+    setPlaying(false)
+  }, [reduced])
+
+  // "Play" auto-scrolls the page at the current tempo. Any manual input takes
+  // the wheel back.
+  useEffect(() => {
+    if (!playing) return
+    let raf = 0
+    let last = performance.now()
+    const stop = () => setPlaying(false)
+    const tick = (now: number) => {
+      const dt = (now - last) / 1000
+      last = now
+      const max = document.documentElement.scrollHeight - window.innerHeight
+      if (window.scrollY >= max - 1) {
+        if (loopRef.current) window.scrollTo({ top: 0 })
+        else {
+          setPlaying(false)
+          return
+        }
+      } else {
+        window.scrollBy(0, PLAY_SPEED * (bpm.get() / BASE_BPM) * dt)
+      }
+      raf = requestAnimationFrame(tick)
+    }
+    raf = requestAnimationFrame(tick)
+    const events = ['wheel', 'touchstart', 'keydown'] as const
+    events.forEach((name) =>
+      window.addEventListener(name, stop, { passive: true }),
+    )
+    return () => {
+      cancelAnimationFrame(raf)
+      events.forEach((name) => window.removeEventListener(name, stop))
+    }
+  }, [playing, bpm])
+
+  return (
+    <main className="min-h-screen bg-[#f4f2ec] text-[#141412]">
+      <Transport
+        progress={progress}
+        bpm={bpm}
+        marks={marks}
+        playing={playing}
+        loop={loop}
+        onTogglePlay={() => setPlaying((p) => !p)}
+        onToggleLoop={() => setLoop((l) => !l)}
+        onSeek={jump}
+      />
+      <StudioHero
+        progress={progress}
+        energy={energy}
+        scrollY={scrollY}
+        reduced={reduced}
+        onJump={jump}
+      />
+      <Stems reduced={reduced} />
+      <SelectedTracks reduced={reduced} />
+      <EndOfTrack onReplay={replay} />
+    </main>
+  )
+}
