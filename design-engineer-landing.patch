+'use client'
+
+import { motion } from 'motion/react'
+import { STEMS, seeded } from './studio-data'
+
+const BARS = 56
+
+export function Stems({ reduced }: { reduced: boolean }) {
+  return (
+    <section id="stems" className="px-5 py-28 sm:px-10">
+      <p className="mb-3 font-mono text-xs tracking-[0.2em] text-black/55 uppercase">
+        01 · Stems
+      </p>
+      <h2 className="mb-14 max-w-2xl text-[clamp(1.9rem,4.4vw,3.6rem)] leading-[1.02] font-semibold tracking-[-0.035em] text-[#141412]">
+        One mix, three stems. Solo any of them and the work falls apart.
+      </h2>
+      <div className="divide-y divide-black/10 border-y border-black/10">
+        {STEMS.map((stem) => (
+          <motion.div
+            key={stem.id}
+            initial={reduced ? false : 'hidden'}
+            whileInView="shown"
+            viewport={{ once: true, margin: '-15% 0px' }}
+            className="grid items-center gap-4 py-7 md:grid-cols-[180px_1fr_1.1fr] md:gap-8"
+          >
+            <h3 className="font-mono text-sm tracking-widest text-[#141412] uppercase">
+              {stem.label}
+            </h3>
+            <p className="text-sm leading-relaxed text-black/65">{stem.line}</p>
+            <div className="flex h-12 items-center gap-[2px]" aria-hidden>
+              {Array.from({ length: BARS }, (_, i) => {
+                const h = 0.18 + seeded(stem.seed, i) * 0.82
+                return (
+                  <motion.span
+                    key={i}
+                    className="w-full origin-center rounded-full bg-[#141412]/80"
+                    style={{ height: `${h * 100}%` }}
+                    variants={{
+                      hidden: { scaleY: 0, opacity: 0 },
+                      shown: {
+                        scaleY: 1,
+                        opacity: 1,
+                        transition: {
+                          type: 'spring',
+                          stiffness: 260,
+                          damping: 18,
+                          delay: i * 0.012,
+                        },
+                      },
+                    }}
+                  />
+                )
+              })}
+            </div>
+          </motion.div>
+        ))}
+      </div>
+    </section>
+  )
+}
