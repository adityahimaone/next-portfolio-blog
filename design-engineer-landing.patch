@@ -0,0 +1,106 @@
+'use client'
+
+import { motion, useTransform } from 'motion/react'
+import type { MotionValue } from 'motion/react'
+import { Pause, Play, Repeat } from 'lucide-react'
+import { CHAPTERS, formatBar, formatTimecode } from './studio-data'
+
+type Props = {
+  progress: MotionValue<number>
+  bpm: MotionValue<number>
+  marks: readonly number[]
+  playing: boolean
+  loop: boolean
+  onTogglePlay: () => void
+  onToggleLoop: () => void
+  onSeek: (chapterId: string) => void
+}
+
+/** The page's playhead: timecode, bar, tempo and a scrubbable chapter strip. */
+export function Transport({
+  progress,
+  bpm,
+  marks,
+  playing,
+  loop,
+  onTogglePlay,
+  onToggleLoop,
+  onSeek,
+}: Props) {
+  const timecode = useTransform(progress, formatTimecode)
+  const bar = useTransform(progress, formatBar)
+  const bpmText = useTransform(bpm, (v) => Math.round(v).toString())
+  const playheadLeft = useTransform(progress, (v) => `${v * 100}%`)
+
+  return (
+    <div className="pointer-events-none fixed inset-x-0 top-3 z-40 flex justify-center px-3">
+      <div className="pointer-events-auto flex w-full max-w-2xl items-center gap-3 rounded-full border border-black/10 bg-[#f4f2ec]/85 py-1.5 pr-4 pl-1.5 shadow-[0_8px_30px_-12px_rgba(0,0,0,0.25)] backdrop-blur-md">
+        <button
+          type="button"
+          onClick={onTogglePlay}
+          aria-label={
+            playing ? 'Pause auto-scroll' : 'Play: auto-scroll the page'
+          }
+          aria-pressed={playing}
+          className="grid size-9 shrink-0 place-items-center rounded-full bg-[#141412] text-[#f4f2ec] transition-transform active:scale-95"
+        >
+          {playing ? (
+            <Pause size={15} />
+          ) : (
+            <Play size={15} className="translate-x-px" />
+          )}
+        </button>
+        <button
+          type="button"
+          onClick={onToggleLoop}
+          aria-label="Loop back to the top at the end"
+          aria-pressed={loop}
+          className={`grid size-8 shrink-0 place-items-center rounded-full transition-colors ${
+            loop ? 'bg-[#ff5b1f] text-white' : 'text-black/50 hover:text-black'
+          }`}
+        >
+          <Repeat size={14} />
+        </button>
+
+        <div
+          className="relative h-6 min-w-0 flex-1"
+          role="group"
+          aria-label="Chapters"
+        >
+          <div className="absolute inset-x-0 top-1/2 h-px -translate-y-1/2 bg-black/15" />
+          <motion.div
+            className="absolute inset-x-0 top-1/2 h-px origin-left -translate-y-1/2 bg-[#ff5b1f]"
+            style={{ scaleX: progress }}
+          />
+          {CHAPTERS.map((chapter, i) => (
+            <button
+              key={chapter.id}
+              type="button"
+              onClick={() => onSeek(chapter.id)}
+              aria-label={`Jump to ${chapter.label}`}
+              title={chapter.label}
+              className="group absolute top-0 h-full w-4 -translate-x-1/2 outline-offset-2"
+              style={{ left: `${(marks[i] ?? 0) * 100}%` }}
+            >
+              <span className="absolute top-1/2 left-1/2 h-3 w-px -translate-x-1/2 -translate-y-1/2 bg-black/40 transition-all group-hover:h-5 group-hover:bg-[#ff5b1f]" />
+            </button>
+          ))}
+          <motion.div
+            className="pointer-events-none absolute top-1/2 left-0 size-2.5 -translate-x-1/2 -translate-y-1/2 rounded-full bg-[#ff5b1f] shadow-[0_0_0_3px_rgba(255,91,31,0.2)]"
+            style={{ left: playheadLeft }}
+          />
+        </div>
+
+        <div className="hidden shrink-0 items-center gap-3 font-mono text-[11px] tracking-wider text-black/60 tabular-nums sm:flex">
+          <motion.span className="text-black">{timecode}</motion.span>
+          <span>
+            BAR <motion.span>{bar}</motion.span>
+          </span>
+          <span>
+            <motion.span>{bpmText}</motion.span> BPM
+          </span>
+        </div>
+      </div>
+    </div>
+  )
+}
