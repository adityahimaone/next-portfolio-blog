@@ -0,0 +1,184 @@
+'use client'
+
+import { Canvas, useFrame } from '@react-three/fiber'
+import { useEffect, useMemo, useRef, useState } from 'react'
+import * as THREE from 'three'
+import type { MotionValue } from 'motion/react'
+
+const BARS = 48
+const RIDGES = 24
+const SIGNAL = '#ff5b1f'
+
+type Pointer = { x: number; y: number }
+
+type RigProps = {
+  progress: MotionValue<number>
+  energy: MotionValue<number>
+  pointer: React.RefObject<Pointer>
+  reduced: boolean
+}
+
+/**
+ * A tactile knob on a ring of level bars. Cursor tilts the whole module, scroll
+ * turns the knob, and scroll speed drives how hard the bars move.
+ */
+function Rig({ progress, energy, pointer, reduced }: RigProps) {
+  const group = useRef<THREE.Group>(null)
+  const cap = useRef<THREE.Group>(null)
+  const bars = useRef<THREE.InstancedMesh>(null)
+  const dummy = useMemo(() => new THREE.Object3D(), [])
+
+  useFrame((state, dt) => {
+    const g = group.current
+    const c = cap.current
+    const b = bars.current
+    if (!g || !c || !b) return
+
+    const p = progress.get()
+    const e = reduced ? 0.15 : Math.min(1, energy.get())
+    const t = state.clock.elapsedTime
+    const px = reduced ? 0 : pointer.current.x
+    const py = reduced ? 0 : pointer.current.y
+
+    g.rotation.x = THREE.MathUtils.damp(g.rotation.x, -0.25 + py * 0.3, 4, dt)
+    g.rotation.y = THREE.MathUtils.damp(
+      g.rotation.y,
+      px * 0.6 + t * 0.05,
+      4,
+      dt,
+    )
+    c.rotation.y = THREE.MathUtils.damp(
+      c.rotation.y,
+      -p * Math.PI * 2 * 4,
+      6,
+      dt,
+    )
+
+    for (let i = 0; i < BARS; i++) {
+      const a = (i / BARS) * Math.PI * 2
+      const wave = 0.5 + 0.5 * Math.sin(a * 3 + t * 2.4 + p * 18)
+      const h = 0.06 + wave * (0.12 + e * 0.5)
+      dummy.position.set(Math.cos(a) * 1.45, 0.11 + h / 2, Math.sin(a) * 1.45)
+      dummy.rotation.set(0, -a, 0)
+      dummy.scale.set(0.07, h, 0.07)
+      dummy.updateMatrix()
+      b.setMatrixAt(i, dummy.matrix)
+    }
+    b.instanceMatrix.needsUpdate = true
+  })
+
+  return (
+    <group ref={group}>
+      <mesh position-y={0}>
+        <cylinderGeometry args={[1.75, 1.8, 0.22, 96]} />
+        <meshStandardMaterial
+          color="#1b1b19"
+          roughness={0.55}
+          metalness={0.25}
+        />
+      </mesh>
+      <mesh rotation-x={-Math.PI / 2} position-y={0.112}>
+        <ringGeometry args={[1.05, 1.7, 96]} />
+        <meshStandardMaterial color="#262623" roughness={0.3} metalness={0.4} />
+      </mesh>
+      <instancedMesh ref={bars} args={[undefined, undefined, BARS]}>
+        <boxGeometry args={[1, 1, 1]} />
+        <meshStandardMaterial
+          color={SIGNAL}
+          emissive={SIGNAL}
+          emissiveIntensity={0.35}
+          roughness={0.5}
+        />
+      </instancedMesh>
+      <group ref={cap} position-y={0.36}>
+        <mesh>
+          <cylinderGeometry args={[0.8, 0.86, 0.5, 64]} />
+          <meshStandardMaterial
+            color="#ecebe4"
+            roughness={0.35}
+            metalness={0.05}
+          />
+        </mesh>
+        <mesh position-y={0.26}>
+          <cylinderGeometry args={[0.62, 0.62, 0.04, 64]} />
+          <meshStandardMaterial color="#dedcd2" roughness={0.4} />
+        </mesh>
+        <mesh position={[0, 0.29, -0.3]}>
+          <boxGeometry args={[0.08, 0.03, 0.34]} />
+          <meshStandardMaterial color={SIGNAL} roughness={0.4} />
+        </mesh>
+        {Array.from({ length: RIDGES }, (_, i) => {
+          const a = (i / RIDGES) * Math.PI * 2
+          return (
+            <mesh
+              key={i}
+              position={[Math.cos(a) * 0.84, 0, Math.sin(a) * 0.84]}
+              rotation-y={-a}
+            >
+              <boxGeometry args={[0.05, 0.44, 0.07]} />
+              <meshStandardMaterial color="#d3d1c6" roughness={0.5} />
+            </mesh>
+          )
+        })}
+      </group>
+    </group>
+  )
+}
+
+type Props = {
+  progress: MotionValue<number>
+  energy: MotionValue<number>
+  reduced: boolean
+}
+
+export default function KnobScene({ progress, energy, reduced }: Props) {
+  const wrap = useRef<HTMLDivElement>(null)
+  const pointer = useRef<Pointer>({ x: 0, y: 0 })
+  const [active, setActive] = useState(true)
+
+  useEffect(() => {
+    const onMove = (event: PointerEvent) => {
+      pointer.current.x = (event.clientX / window.innerWidth) * 2 - 1
+      pointer.current.y = (event.clientY / window.innerHeight) * 2 - 1
+    }
+    window.addEventListener('pointermove', onMove, { passive: true })
+    return () => window.removeEventListener('pointermove', onMove)
+  }, [])
+
+  // Stop rendering when the hero is off screen: a WebGL loop nobody can see is
+  // the most expensive thing on the page.
+  useEffect(() => {
+    const el = wrap.current
+    if (!el) return
+    const io = new IntersectionObserver(([entry]) =>
+      setActive(entry.isIntersecting),
+    )
+    io.observe(el)
+    return () => io.disconnect()
+  }, [])
+
+  return (
+    <div ref={wrap} className="absolute inset-0" aria-hidden>
+      <Canvas
+        frameloop={active ? 'always' : 'never'}
+        dpr={[1, 1.75]}
+        camera={{ position: [0, 3.1, 5.4], fov: 32 }}
+        gl={{ antialias: true, alpha: true }}
+      >
+        <ambientLight intensity={0.9} />
+        <directionalLight position={[3, 5, 4]} intensity={2.2} />
+        <directionalLight
+          position={[-4, 2, -3]}
+          intensity={0.8}
+          color="#ffb48a"
+        />
+        <Rig
+          progress={progress}
+          energy={energy}
+          pointer={pointer}
+          reduced={reduced}
+        />
+      </Canvas>
+    </div>
+  )
+}
