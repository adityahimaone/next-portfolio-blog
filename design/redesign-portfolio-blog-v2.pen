         "content": "// deleting ruthlessly was the second most important thing.",
         "x": 18,
         "y": 140,
         "fontFamily": "Geist Mono",
         "fontWeight": "400",
         "fontSize": 9,
         "fill": "#FFFFFF55",
         "textGrowth": "fixed-width",
