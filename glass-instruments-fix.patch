+/**
+ * A soft contact shadow, one shared radial-falloff texture on a plane under a
+ * raised part. It is what turns a flat orthographic top-down render into
+ * something that reads as stacked: without it a pad and the plate under it are
+ * two rectangles; with it the pad is *on* the plate. Skipped where there is no
+ * canvas to draw the texture on (the headless tests).
+ */
+let shadowMap: THREE.Texture | null | undefined
+function shadowTexture(): THREE.Texture | null {
+  if (shadowMap !== undefined) return shadowMap
+  if (typeof document === 'undefined') return (shadowMap = null)
+  const canvas = document.createElement('canvas')
+  canvas.width = canvas.height = 128
+  const ctx = canvas.getContext('2d')
+  if (!ctx) return (shadowMap = null)
+  const g = ctx.createRadialGradient(64, 64, 8, 64, 64, 64)
+  g.addColorStop(0, 'rgba(0,0,0,0.62)')
+  g.addColorStop(0.55, 'rgba(0,0,0,0.3)')
+  g.addColorStop(1, 'rgba(0,0,0,0)')
+  ctx.fillStyle = g
+  ctx.fillRect(0, 0, 128, 128)
+  shadowMap = new THREE.CanvasTexture(canvas)
+  return shadowMap
+}
+
+function shade(
+  root: THREE.Group,
+  at: { x: number; y: number; w: number; h: number },
+  z: number,
+  grow = 1.35,
+  dx = 2,
+  dy = -4,
+) {
+  const map = shadowTexture()
+  if (!map) return
+  const plane = new THREE.Mesh(
+    new THREE.PlaneGeometry(at.w * grow, at.h * grow),
+    new THREE.MeshBasicMaterial({
+      map,
+      transparent: true,
+      depthWrite: false,
+      opacity: 0.8,
+    }),
+  )
+  plane.position.set(at.x + dx, at.y + dy, z)
+  plane.renderOrder = 6
+  root.add(plane)
+}
