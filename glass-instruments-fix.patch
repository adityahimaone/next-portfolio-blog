+describe('stackOffsets', () => {
+  const node = (offsetLeft: number, offsetTop: number, border = 0) => ({
+    offsetLeft,
+    offsetTop,
+    clientLeft: border,
+    clientTop: border,
+  })
+
+  it('is just the offset for a direct child of the host', () => {
+    expect(stackOffsets([node(40, 30)])).toEqual({ x: 40, y: 30 })
+  })
+
+  it('sums a nested chain and adds each parent border on the way up', () => {
+    // el sits 10/5 inside a bank that has a 2px border, and the bank sits
+    // 100/200 inside the host.
+    expect(stackOffsets([node(10, 5), node(100, 200, 2)])).toEqual({
+      x: 112,
+      y: 207,
+    })
+  })
+
+  it("does not count the element's own border, only its parents'", () => {
+    expect(stackOffsets([node(10, 5, 4)])).toEqual({ x: 10, y: 5 })
+  })
+
+  it('is empty for an empty chain', () => {
+    expect(stackOffsets([])).toEqual({ x: 0, y: 0 })
+  })
+})
+
