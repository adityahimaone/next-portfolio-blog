diff --git a/features/landing-page/components/instrument/instrument-layout.ts b/features/landing-page/components/instrument/instrument-layout.ts
index a646b85..8d1933d 100644
--- a/features/landing-page/components/instrument/instrument-layout.ts
+++ b/features/landing-page/components/instrument/instrument-layout.ts
@@ -183,3 +183,69 @@ export function readPartAttributes(
     value: Number.isFinite(value) ? value : 0,
   }
 }
+
+/**
+ * A node's position inside its host from `offsetLeft`/`offsetTop`, which are
+ * layout and so unaffected by any transform.
+ *
+ * This replaced `getBoundingClientRect` arithmetic, which failed on the real
+ * page: the Skills controller is scroll-scrubbed by GSAP (`rotationX: 20 → 0`
+ * under a 1200px perspective, with a scale), and a screen-space rectangle taken
+ * while it is tilted is a perspective-distorted quadrilateral that no uniform
+ * scale can undo. The model was built from those rectangles and never rebuilt,
+ * so every part sat where its control *had been* mid-tilt — pads right and up,
+ * faders left. Layout space has no tilt to undo.
+ *
+ * `chain[0]` is the node itself and each later entry is the previous one's
+ * `offsetParent`, stopping before the host. An `offsetLeft` is measured from
+ * its parent's *padding* edge, so each parent's border (`clientLeft/Top`) is
+ * added on the way up.
+ */
+export function stackOffsets(
+  chain: {
+    offsetLeft: number
+    offsetTop: number
+    clientLeft: number
+    clientTop: number
+  }[],
+): { x: number; y: number } {
+  let x = 0
+  let y = 0
+  chain.forEach((node, index) => {
+    x += node.offsetLeft
+    y += node.offsetTop
+    if (index > 0) {
+      x += node.clientLeft
+      y += node.clientTop
+    }
+  })
+  return { x, y }
+}
+
+/**
+ * The translation in a computed `transform`, if it is a pure translation.
+ *
+ * Some controls are positioned with a *static* transform (the black keys sit
+ * on `translateX(-50%)`), which layout offsets do not include. A matrix with a
+ * scale or a rotation in it is something else (a pressed key, an animation) and
+ * is deliberately read as no offset at all, so a transient never moves a part.
+ */
+export function parseTranslation(transform: string | null | undefined): {
+  x: number
+  y: number
+} {
+  const raw = (transform ?? '').trim()
+  const flat = /^matrix\(([^)]+)\)$/.exec(raw)
+  if (flat) {
+    const [a, b, c, d, tx, ty] = flat[1].split(',').map(Number)
+    const pure =
+      Math.abs(a - 1) < 1e-6 &&
+      Math.abs(d - 1) < 1e-6 &&
+      Math.abs(b) < 1e-6 &&
+      Math.abs(c) < 1e-6
+    return pure && Number.isFinite(tx) && Number.isFinite(ty)
+      ? { x: tx, y: ty }
+      : { x: 0, y: 0 }
+  }
+  return { x: 0, y: 0 }
+}
