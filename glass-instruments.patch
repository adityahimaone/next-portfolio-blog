diff --git a/tests/instrument-layout.test.ts b/tests/instrument-layout.test.ts
new file mode 100644
index 0000000..2a65033
--- /dev/null
+++ b/tests/instrument-layout.test.ts
@@ -0,0 +1,197 @@
+import {
+  approach,
+  clamp,
+  knobDegrees,
+  ledLevels,
+  parseId,
+  parsePercent,
+  parseRotation,
+  pressDepth,
+  readPartAttributes,
+  relativeRect,
+  tiltFromPointer,
+  toModel,
+  wheelTurn,
+} from '@/features/landing-page/components/instrument/instrument-layout'
+
+describe('parseId', () => {
+  it('splits kind and key, and tolerates singletons', () => {
+    expect(parseId('pad:3')).toEqual({ kind: 'pad', key: '3' })
+    expect(parseId('wheel:pitch')).toEqual({ kind: 'wheel', key: 'pitch' })
+    expect(parseId('lcd')).toEqual({ kind: 'lcd', key: '' })
+    expect(parseId('a:b:c')).toEqual({ kind: 'a', key: 'b:c' })
+  })
+})
+
+describe('relativeRect', () => {
+  const host = { x: 100, y: 50, w: 800, h: 400 }
+
+  it('is the plain offset when the host is not scaled', () => {
+    expect(relativeRect({ x: 140, y: 80, w: 40, h: 20 }, host, 800)).toEqual({
+      x: 40,
+      y: 30,
+      w: 40,
+      h: 20,
+    })
+  })
+
+  it('undoes a host transform, so the model is built in layout space', () => {
+    // Drawn at half size: a child 20px in from the left is 40px in layout.
+    const scaled = { x: 0, y: 0, w: 400, h: 200 }
+    expect(relativeRect({ x: 20, y: 10, w: 10, h: 10 }, scaled, 800)).toEqual({
+      x: 40,
+      y: 20,
+      w: 20,
+      h: 20,
+    })
+  })
+
+  it('refuses a host with no layout', () => {
+    expect(relativeRect({ x: 0, y: 0, w: 1, h: 1 }, host, 0)).toBeNull()
+    expect(
+      relativeRect({ x: 0, y: 0, w: 1, h: 1 }, { x: 0, y: 0, w: 0, h: 0 }, 10),
+    ).toBeNull()
+  })
+})
+
+describe('toModel', () => {
+  it('centres the origin and flips y', () => {
+    // A 100×60 box in the top-left corner of a 400×200 host.
+    expect(toModel({ x: 0, y: 0, w: 100, h: 60 }, 400, 200)).toEqual({
+      x: -150,
+      y: 70,
+      w: 100,
+      h: 60,
+    })
+    // A box exactly in the middle sits on the origin.
+    const mid = toModel({ x: 150, y: 70, w: 100, h: 60 }, 400, 200)
+    expect(mid.x).toBe(0)
+    expect(mid.y).toBe(0)
+  })
+})
+
+describe('knobDegrees / parse helpers', () => {
+  it('maps 0–100 onto −125…+125, clamped', () => {
+    expect(knobDegrees(0)).toBe(-125)
+    expect(knobDegrees(50)).toBe(0)
+    expect(knobDegrees(100)).toBe(125)
+    expect(knobDegrees(400)).toBe(125)
+    expect(knobDegrees(-9)).toBe(-125)
+  })
+
+  it('reads the rotation and the needle position the deck writes', () => {
+    expect(parseRotation('rotate(135deg)')).toBe(135)
+    expect(parseRotation('rotate(-20.5deg)')).toBe(-20.5)
+    expect(parseRotation('')).toBe(0)
+    expect(parseRotation(null)).toBe(0)
+    expect(parsePercent('36%')).toBe(36)
+    expect(parsePercent(' 92% ')).toBe(92)
+    expect(parsePercent('12px')).toBe(0)
+    expect(parsePercent(undefined)).toBe(0)
+  })
+})
+
+describe('approach', () => {
+  it('lands exactly on the target, so the renderer can sleep', () => {
+    let v = 0
+    for (let i = 0; i < 600; i += 1) v = approach(v, 10, 12, 1 / 60)
+    expect(v).toBe(10)
+  })
+
+  it('settles in the same wall-clock time at any frame rate', () => {
+    const run = (fps: number) => {
+      let v = 0
+      for (let i = 0; i < fps * 0.5; i += 1) v = approach(v, 1, 10, 1 / fps, 0)
+      return v
+    }
+    expect(run(60)).toBeCloseTo(run(144), 6)
+  })
+
+  it('never overshoots, and ignores a negative step', () => {
+    expect(approach(0, 1, 1000, 10)).toBe(1)
+    expect(approach(0, 1, 5, -1)).toBe(0)
+  })
+})
+
+describe('ledLevels', () => {
+  it('breathes on the two low bars when at rest, nothing above', () => {
+    const rest = ledLevels(1.3, 0)
+    expect(rest).toHaveLength(8)
+    expect(rest[0]).toBeGreaterThan(0)
+    expect(rest[1]).toBeGreaterThan(0)
+    expect(rest.slice(2).every((v) => v === 0)).toBe(true)
+  })
+
+  it('stays inside 0–1 and lights higher bars as the drive rises', () => {
+    for (let t = 0; t < 10; t += 0.37) {
+      for (const level of ledLevels(t, 1)) {
+        expect(level).toBeGreaterThanOrEqual(0)
+        expect(level).toBeLessThanOrEqual(1)
+      }
+    }
+    const lit = (d: number) => ledLevels(0.8, d).reduce((sum, v) => sum + v, 0)
+    expect(lit(1)).toBeGreaterThan(lit(0.3))
+    expect(lit(0.3)).toBeGreaterThanOrEqual(lit(0))
+  })
+
+  it('treats a bad drive as rest', () => {
+    expect(ledLevels(1, Number.NaN)).toEqual(ledLevels(1, 0))
+  })
+})
+
+describe('pressDepth', () => {
+  it('sinks when pressed, lifts a little on hover, and rests at zero', () => {
+    expect(pressDepth('pad', true, false)).toBeLessThan(0)
+    expect(pressDepth('pad', false, true)).toBeGreaterThan(0)
+    expect(pressDepth('pad', false, false)).toBe(0)
+    // Pressed wins over hover: a pointer is always hovering what it presses.
+    expect(pressDepth('key', true, true)).toBeLessThan(0)
+  })
+})
+
+describe('wheelTurn', () => {
+  it('rests pitch bend at the middle and runs mod from the bottom', () => {
+    expect(wheelTurn('pitch', 0)).toBe(0.5)
+    expect(wheelTurn('pitch', -50)).toBe(0)
+    expect(wheelTurn('pitch', 50)).toBe(1)
+    expect(wheelTurn('mod', 0)).toBe(0)
+    expect(wheelTurn('mod', 100)).toBe(1)
+    expect(wheelTurn('mod', 900)).toBe(1)
+  })
+})
+
+describe('tiltFromPointer', () => {
+  it('is bounded by max and centred on zero', () => {
+    expect(tiltFromPointer(0, 0)).toEqual({ rx: 0, ry: 0 })
+    expect(tiltFromPointer(9, -9, 3)).toEqual({ rx: -3, ry: 3 })
+  })
+})
+
+describe('readPartAttributes', () => {
+  const from = (attrs: Record<string, string>) =>
+    readPartAttributes((name) => attrs[name] ?? null)
+
+  it('reads pressed, hit and value from the control itself', () => {
+    expect(from({ 'aria-pressed': 'true', 'data-hit': 'true' })).toEqual({
+      pressed: true,
+      hit: true,
+      value: 0,
+    })
+    expect(from({ 'aria-valuenow': '72' }).value).toBe(72)
+    expect(from({ 'data-v': '41' }).value).toBe(41)
+    expect(from({ 'data-on': 'true' }).pressed).toBe(true)
+  })
+
+  it('prefers aria-valuenow, and never returns NaN', () => {
+    expect(from({ 'aria-valuenow': '5', 'data-v': '9' }).value).toBe(5)
+    expect(from({ 'aria-valuenow': 'abc' }).value).toBe(0)
+    expect(from({}).value).toBe(0)
+  })
+})
+
+describe('clamp', () => {
+  it('treats NaN as the lower bound', () => {
+    expect(clamp(Number.NaN, 2, 5)).toBe(2)
+    expect(clamp(9, 2, 5)).toBe(5)
+  })
+})
