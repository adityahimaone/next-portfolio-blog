+        frame.pressed === 'speaker' ||
+        frame.pressed === 'dial:tune'
+      drive = approach(drive, hot ? 1 : 0.25, 6, frame.dt, 0.01)
+      ledLevels(frame.time, drive, count).forEach((value, index) => {
+        bars[index].material.emissiveIntensity = value * 1.5
+      })
+      // The LEDs breathe forever; the renderer only needs to keep drawing while
+      // they are visible, which is what the host's visibility gate decides. A
+      // visitor who asked for reduced motion gets them still, and the loop
+      // sleeps like it does on the controller.
+      return !stillRequested() || drive !== (hot ? 1 : 0.25)
+    })
+  }
+
+  for (const id of ['dial:vol', 'dial:tune']) {
+    const part = get(id)
+    if (!part) continue
+    const at = place(part)
+    const { group, cap } = knobMesh(at)
+    group.position.set(at.x, at.y, face)
+    root.add(group)
+    let angle = 0
+    let first = true
+    movers.push((frame) => {
+      const raw = valueOf(frame, id).value
+      // The deck writes the TUNE dial in degrees and leaves VOL at rest.
+      const target = id === 'dial:vol' ? 40 : raw % 360
+      angle = first ? target : approach(angle, target, 10, frame.dt, 0.1)
+      first = false
+      cap.rotation.z = -angle * DEG
+      return angle !== target
+    })
+  }
+
+  const bay = get('bay')
+  if (bay) {
+    const at = place(bay)
+    const well = slab(at.w + 8, at.h + 8, 6, inner(0x1d1f1e, 0.3), 8)
+    well.position.set(at.x, at.y, face + 1)
+    root.add(well)
+  }
+
+  return finish(root, movers, () => {
+    if (speakerGroup) speakerGroup.scale.setScalar(1)
+  })
+}
+
+function finish(
+  root: THREE.Group,
+  movers: Mover[],
+  onSettle?: () => void,
+): InstrumentScene {
+  return {
+    root,
+    update(frame) {
+      let moving = false
+      for (const mover of movers) if (mover(frame)) moving = true
+      if (!moving) onSettle?.()
+      return moving
+    },
+    dispose() {
+      disposeMaterials(root)
+      root.clear()
+    },
+  }
+}
diff --git a/features/landing-page/components/instrument/use-instrument.ts b/features/landing-page/components/instrument/use-instrument.ts
new file mode 100644
index 0000000..328e791
--- /dev/null
+++ b/features/landing-page/components/instrument/use-instrument.ts
@@ -0,0 +1,102 @@
+'use client'
+
+import { useEffect, type RefObject } from 'react'
+
+import type { Instrument } from './instrument-core'
+
+export type InstrumentKind = 'controller' | 'radio'
+
+/** Same breakpoint the rack's desktop-only motion uses. */
+const DESKTOP = '(min-width: 769px)'
+
+/**
+ * Give a DOM device a glass surface behind it.
+ *
+ * Nothing about the device's own behaviour moves into this hook: it finds the
+ * host, and — only on a desktop-width screen, and only once the device is
+ * within a screen of the viewport — loads three.js and mounts an instrument
+ * behind the host's children. three.js is imported inside that path, so none of
+ * it is part of first load, and a phone never downloads it.
+ *
+ * The instrument flips `data-instrument="on"` on the host once it has a first
+ * frame; the stylesheet hides the DOM surfaces only then. If WebGL is missing,
+ * the import fails or the context is lost, the attribute never appears (or is
+ * removed) and the DOM device is exactly what it was authored as.
+ */
+export function useInstrument(
+  hostRef: RefObject<HTMLElement | null>,
+  kind: InstrumentKind,
+) {
+  useEffect(() => {
+    const host = hostRef.current
+    if (!host) return
+
+    const query = window.matchMedia(DESKTOP)
+    let instrument: Instrument | null = null
+    let observer: IntersectionObserver | null = null
+    let disposed = false
+    let generation = 0
+
+    const stop = () => {
+      generation += 1
+      observer?.disconnect()
+      observer = null
+      instrument?.dispose()
+      instrument = null
+    }
+
+    const start = async () => {
+      const mine = generation
+      try {
+        const [core, models] = await Promise.all([
+          import('./instrument-core'),
+          import('./instrument-models'),
+        ])
+        if (disposed || mine !== generation) return
+        // A font or an image can still be settling the host's layout; measure
+        // on the next frame so the first build sees the real rectangles.
+        await new Promise<void>((resolve) =>
+          requestAnimationFrame(() => resolve()),
+        )
+        if (disposed || mine !== generation) return
+        instrument = core.mountInstrument(
+          host,
+          kind === 'controller' ? models.buildController : models.buildRadio,
+        )
+      } catch (error) {
+        console.error('Glass instrument: could not load', error)
+      }
+    }
+
+    const arm = () => {
+      if (observer || instrument) return
+      if (typeof IntersectionObserver === 'undefined') {
+        void start()
+        return
+      }
+      observer = new IntersectionObserver(
+        (entries) => {
+          if (!entries.some((entry) => entry.isIntersecting)) return
+          observer?.disconnect()
+          observer = null
+          void start()
+        },
+        { rootMargin: '600px' },
+      )
+      observer.observe(host)
+    }
+
+    const sync = () => {
+      if (query.matches) arm()
+      else stop()
+    }
+
+    sync()
+    query.addEventListener('change', sync)
+    return () => {
+      disposed = true
+      query.removeEventListener('change', sync)
+      stop()
+    }
+  }, [hostRef, kind])
+}
