+} from './instrument-layout'
+
+/**
+ * The two playable devices, as glass hardware.
+ *
+ * Both are built from the same kit the About section's sampler, cassette and
+ * player are built from (`glassShell`, `inner`, `emissive`): a frosted cream
+ * shell with a dark rim over an opaque cream chassis, near-black glass for the
+ * screens, dark pads that light orange, brushed metal for the knobs. They are
+ * not "inspired by" those devices; they are drawn with the same materials, so
+ * a pad here and a pad on the sampler are the same pad.
+ *
+ * Each scene is a function of the measured `Part`s and returns a scene whose
+ * `update` reads `PartState`s. Neither knows what a skill or an experience is.
+ */
+
+const DEG = Math.PI / 180
+
+/** Chassis face height above the origin, once the shell's depth is chosen. */
+const faceOf = (depth: number) => depth / 2 - 6
+
+/* ── Kit ─────────────────────────────────────────────────── */
+
+const geometries = new Map<string, THREE.BufferGeometry>()
+function boxGeometry(w: number, h: number, d: number, r: number) {
+  const radius = Math.max(
+    0.2,
+    Math.min(r, w / 2 - 0.01, h / 2 - 0.01, d / 2 - 0.01),
+  )
+  const key = [w, h, d, radius].map((n) => n.toFixed(1)).join('x')
+  let geometry = geometries.get(key)
+  if (!geometry) {
+    geometry = new RoundedBoxGeometry(w, h, d, 3, radius)
+    geometries.set(key, geometry)
+  }
+  return geometry
+}
+
+/**
+ * Geometry is cached across scenes (a rebuild after a resize re-uses it), so a
+ * scene must not dispose it. Materials are per-scene and are disposed.
+ */
+function disposeMaterials(root: THREE.Object3D) {
+  root.traverse((object) => {
+    const mesh = object as THREE.Mesh
+    const material = mesh.material
+    if (Array.isArray(material)) material.forEach((m) => m.dispose())
+    else material?.dispose()
+  })
+}
+
+function slab(
+  w: number,
+  h: number,
+  d: number,
+  material: THREE.Material,
+  r = 3,
+) {
+  return new THREE.Mesh(boxGeometry(w, h, d, r), material)
+}
+
+function brushedMetal() {
+  return new THREE.MeshStandardMaterial({
+    color: 0xdedbd4,
+    metalness: 1,
+    roughness: 0.28,
+  })
+}
+
+/** The shell and chassis every device here sits in. */
+function body(width: number, height: number, depth: number, radius: number) {
+  const group = new THREE.Group()
+  const r = Math.min(radius + 4, depth / 2 - 0.5)
+  const shell = glassShell(new RoundedBoxGeometry(width, height, depth, 5, r))
+  // The About devices' rim is a 2.5% scale-up on a unit-sized body; on a
+  // device a thousand pixels wide that would be thirty pixels of rim, so it is
+  // set as a fixed few pixels in each axis instead.
+  shell.children[0].scale.set(1 + 4 / width, 1 + 4 / height, 1 + 8 / depth)
+  group.add(shell)
+  group.add(
+    slab(
+      width - 10,
+      height - 10,
+      depth - 12,
+      inner(0xcfc9bc),
+      Math.max(4, r - 4),
+    ),
+  )
+  return group
+}
+
+type Mover = (frame: FrameContext) => boolean
+
+const stillRequested = () =>
+  typeof window !== 'undefined' &&
+  typeof window.matchMedia === 'function' &&
+  window.matchMedia('(prefers-reduced-motion: reduce)').matches
+
+/** One knob: brushed metal, an orange pointer, turned to an angle. */
+function knobMesh(rect: { w: number; h: number }) {
+  const radius = (Math.min(rect.w, rect.h) / 2) * 0.9
+  const group = new THREE.Group()
+  const base = new THREE.Mesh(
+    new THREE.CylinderGeometry(radius * 1.08, radius * 1.12, 4, 40),
+    inner(0x2a2e2b, 0.5),
+  )
+  base.rotation.x = Math.PI / 2
+  group.add(base)
+  const cap = new THREE.Group()
+  const disc = new THREE.Mesh(
+    new THREE.CylinderGeometry(radius, radius, 11, 40),
+    brushedMetal(),
+  )
+  disc.rotation.x = Math.PI / 2
+  disc.position.z = 7
+  cap.add(disc)
+  const pointer = slab(
+    radius * 0.16,
+    radius * 0.5,
+    2,
+    emissive(0xff5a1f, 0.9),
+    0.8,
+  )
+  pointer.position.set(0, radius * 0.5, 12.6)
+  cap.add(pointer)
+  group.add(cap)
+  return { group, cap }
+}
+
+const valueOf = (frame: FrameContext, id: string): PartState =>
+  frame.states.get(id) ?? { pressed: false, hit: false, value: 0 }
+
+/* ── The Skills controller ───────────────────────────────── */
+
+export const buildController: SceneBuilder = (parts, size) => {
+  const { width, height, radius } = size
+  const depth = 34
+  const face = faceOf(depth)
+  const root = new THREE.Group()
+  root.add(body(width, height, depth, radius))
