diff --git a/features/landing-page/rack-01/radio-audio.ts b/features/landing-page/rack-01/radio-audio.ts
new file mode 100644
index 0000000..4577ad8
--- /dev/null
+++ b/features/landing-page/rack-01/radio-audio.ts
@@ -0,0 +1,88 @@
+/**
+ * The radio's two sounds, made on demand with the Web Audio API.
+ *
+ * Both are tiny and quiet, and neither exists until a pointer has touched the
+ * set (an AudioContext created before a gesture is suspended anyway): turning
+ * the TUNE dial sweeps a band of static toward the station and lands on a short
+ * tone, and a tap on the speaker is a soft burst of noise. There are no assets.
+ */
+
+let context: AudioContext | null = null
+
+function getContext(): AudioContext | null {
+  if (typeof window === 'undefined') return null
+  if (!context) {
+    const Ctor =
+      window.AudioContext ||
+      (window as unknown as { webkitAudioContext?: typeof AudioContext })
+        .webkitAudioContext
+    if (!Ctor) return null
+    context = new Ctor()
+  }
+  if (context.state === 'suspended') void context.resume()
+  return context
+}
+
+function noise(ctx: AudioContext, seconds: number) {
+  const length = Math.max(1, Math.floor(ctx.sampleRate * seconds))
+  const buffer = ctx.createBuffer(1, length, ctx.sampleRate)
+  const data = buffer.getChannelData(0)
+  for (let i = 0; i < length; i += 1) data[i] = Math.random() * 2 - 1
+  const source = ctx.createBufferSource()
+  source.buffer = buffer
+  return source
+}
+
+/** The pitch a station lands on: 88–108 MHz spread over an octave of A. */
+export function stationHz(mhz: number) {
+  const t = Math.min(1, Math.max(0, (mhz - 88) / 20))
+  return 330 * Math.pow(2, t)
+}
+
+/** Static sweeping to a station, then a short tone on it. */
+export function playTune(mhz: number) {
+  const ctx = getContext()
+  if (!ctx) return
+  const now = ctx.currentTime
+  const source = noise(ctx, 0.34)
+  const band = ctx.createBiquadFilter()
+  band.type = 'bandpass'
+  band.Q.value = 4
+  band.frequency.setValueAtTime(600, now)
+  band.frequency.exponentialRampToValueAtTime(stationHz(mhz) * 2, now + 0.3)
+  const hiss = ctx.createGain()
+  hiss.gain.setValueAtTime(0.0001, now)
+  hiss.gain.exponentialRampToValueAtTime(0.07, now + 0.04)
+  hiss.gain.exponentialRampToValueAtTime(0.0001, now + 0.34)
+  source.connect(band).connect(hiss).connect(ctx.destination)
+  source.start(now)
+  source.stop(now + 0.34)
+
+  const tone = ctx.createOscillator()
+  const level = ctx.createGain()
+  tone.type = 'triangle'
+  tone.frequency.setValueAtTime(stationHz(mhz), now + 0.26)
+  level.gain.setValueAtTime(0.0001, now + 0.26)
+  level.gain.exponentialRampToValueAtTime(0.1, now + 0.29)
+  level.gain.exponentialRampToValueAtTime(0.0001, now + 0.62)
+  tone.connect(level).connect(ctx.destination)
+  tone.start(now + 0.26)
+  tone.stop(now + 0.64)
+}
+
+/** A soft tap on the speaker cone. */
+export function playTap() {
+  const ctx = getContext()
+  if (!ctx) return
+  const now = ctx.currentTime
+  const source = noise(ctx, 0.12)
+  const low = ctx.createBiquadFilter()
+  low.type = 'lowpass'
+  low.frequency.value = 900
+  const gain = ctx.createGain()
+  gain.gain.setValueAtTime(0.09, now)
+  gain.gain.exponentialRampToValueAtTime(0.0001, now + 0.12)
+  source.connect(low).connect(gain).connect(ctx.destination)
+  source.start(now)
+  source.stop(now + 0.12)
+}
