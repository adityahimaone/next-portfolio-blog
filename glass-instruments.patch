+  const movers: Mover[] = []
+  const place = (part: Part) => toModel(part, width, height)
+
+  const keyParts = parts.filter((p) => p.kind === 'key')
+  const tallest = Math.max(1, ...keyParts.map((p) => p.h))
+
+  for (const part of parts) {
+    const at = place(part)
+
+    if (part.kind === 'lcd') {
+      // Two steps of recess: a pale bezel, then near-black glass. The DOM
+      // screen's own readouts and scope are drawn over the glass.
+      const bezel = slab(at.w + 12, at.h + 12, 4, inner(0xb9b3a5, 0.5), 6)
+      bezel.position.set(at.x, at.y, face + 0.5)
+      const glass = slab(at.w + 2, at.h + 2, 6, inner(0x0b0d0c, 0.22), 5)
+      glass.position.set(at.x, at.y, face + 1.5)
+      root.add(bezel, glass)
+    }
+
+    if (part.kind === 'bed') {
+      const bed = slab(at.w, at.h, 4, inner(0xb2ac9e, 0.6), 6)
+      bed.position.set(at.x, at.y, face + 0.5)
+      root.add(bed)
+    }
+
+    if (part.kind === 'arp' || part.kind === 'pwr') {
