new file mode 100644
index 0000000..a646b85
--- /dev/null
+++ b/features/landing-page/components/instrument/instrument-layout.ts
@@ -0,0 +1,185 @@
+/**
+ * Pure helpers for the glass instruments. No three.js, no DOM globals beyond
+ * the structural types, so everything here runs under jest.
+ *
+ * ## The idea the helpers serve
+ *
+ * The Skills controller and the Experience radio are the page's two *playable*
+ * devices, and their markup already does everything a playable device has to:
+ * buttons, sliders, a keyboard, focus order, `aria-*`, the audio. The glass
+ * instruments do not replace any of that. They are a **surface layer**: a
+ * three.js canvas behind the live DOM, drawing the glass, the metal and the
+ * light the same way the About section's devices are drawn, and *reading* the
+ * DOM to know what to show.
+ *
+ * - **Layout comes from the DOM.** Every control carries `data-i3d="kind:id"`;
+ *   the model is built at those controls' measured rectangles, so a different
+ *   key count, a reflowed grid or a media query changes nothing here.
+ * - **State comes from the DOM.** A pad is pressed when its `aria-pressed` says
+ *   so, a knob is at its `aria-valuenow`, a fader at its `data-v`. A
+ *   MutationObserver wakes the renderer; nothing in React knows the canvas
+ *   exists, so the audio, the shortcuts and the scroll sequence are untouched.
+ * - **The DOM is the fallback.** No WebGL, a lost context, a phone: the canvas
+ *   never takes over and the controller is exactly what it was.
+ */
+
+export type Rect = { x: number; y: number; w: number; h: number }
+
+export type Part = Rect & {
+  /** The full `data-i3d` value, e.g. `pad:3`. */
+  id: string
+  /** The part before the colon, e.g. `pad`. */
+  kind: string
+  /** The part after it, e.g. `3`. Empty for singletons like `lcd`. */
+  key: string
+}
+
+/** What a control's own attributes say about it. */
+export type PartState = {
+  pressed: boolean
+  hit: boolean
+  value: number
+}
+
+export const clamp = (n: number, lo: number, hi: number) =>
+  Number.isFinite(n) ? Math.min(hi, Math.max(lo, n)) : lo
+
+export const clamp01 = (n: number) => clamp(n, 0, 1)
+
+/** `"pad:3"` → `{ kind: 'pad', key: '3' }`. */
+export function parseId(id: string): { kind: string; key: string } {
+  const at = id.indexOf(':')
+  return at < 0
+    ? { kind: id, key: '' }
+    : { kind: id.slice(0, at), key: id.slice(at + 1) }
+}
+
+/**
+ * A child's box in the host's own, unscaled CSS pixels.
+ *
+ * `getBoundingClientRect` reports what is on screen, which includes any
+ * transform on the host (the scroll sequences scale it). The model is built in
+ * the host's layout space, so the offset is divided by the host's own scale,
+ * which is the ratio of its drawn width to its layout width. A host with no
+ * layout width (display: none) has no scale to recover and yields `null`.
+ */
+export function relativeRect(
+  child: Rect,
+  host: Rect,
+  hostLayoutWidth: number,
+): Rect | null {
+  if (!(hostLayoutWidth > 0) || !(host.w > 0)) return null
+  const scale = host.w / hostLayoutWidth
+  return {
+    x: (child.x - host.x) / scale,
+    y: (child.y - host.y) / scale,
+    w: child.w / scale,
+    h: child.h / scale,
+  }
+}
+
+/** DOM space (origin top-left, y down) → model space (origin centre, y up). */
+export function toModel(rect: Rect, width: number, height: number) {
+  return {
+    x: rect.x + rect.w / 2 - width / 2,
+    y: height / 2 - (rect.y + rect.h / 2),
+    w: rect.w,
+    h: rect.h,
+  }
+}
+
+/** The knob's pointer angle in degrees for a 0–100 value: −125° to +125°. */
+export const knobDegrees = (value: number) => -125 + clamp(value, 0, 100) * 2.5
+
+/** `"rotate(135deg)"` → 135. Anything else → 0. */
+export function parseRotation(transform: string | null | undefined): number {
+  const match = /rotate\((-?[\d.]+)deg\)/.exec(transform ?? '')
+  return match ? Number(match[1]) : 0
+}
+
+/** `"36%"` → 36. Anything else → 0. */
+export function parsePercent(value: string | null | undefined): number {
+  const match = /^(-?[\d.]+)%$/.exec((value ?? '').trim())
+  return match ? Number(match[1]) : 0
+}
+
+/**
+ * Move `current` toward `target`, frame-rate independent.
+ *
+ * `rate` is the fraction of the remaining distance covered per second in the
+ * exponential sense (`1 - e^(-rate·dt)`), so 60fps and 144fps displays settle
+ * in the same wall-clock time. It lands exactly on the target inside `epsilon`,
+ * which is what lets the renderer know it has stopped and go to sleep.
+ */
+export function approach(
+  current: number,
+  target: number,
+  rate: number,
+  dt: number,
+  epsilon = 0.0005,
+): number {
+  const gap = target - current
+  if (Math.abs(gap) <= epsilon) return target
+  const next =
+    current + gap * (1 - Math.exp(-Math.max(0, rate) * Math.max(0, dt)))
+  return Math.abs(target - next) <= epsilon ? target : next
+}
+
+/**
+ * The radio's eight level LEDs, 0–1 each, as a function of time and how hard
+ * the set is being driven. A resting radio breathes (two low bars); a driven one
+ * climbs and dances. Pure and bounded, so the meter can be asserted on.
+ */
+export function ledLevels(time: number, drive: number, count = 8): number[] {
+  const d = clamp01(drive)
+  return Array.from({ length: count }, (_, i) => {
+    const wave = 0.5 + 0.5 * Math.sin(time * 5.2 + i * 1.3)
+    const ceiling = d * (count - i * 0.45) // lower bars light first
+    const level = clamp01(((ceiling * (0.45 + 0.55 * wave)) / count) * 1.6)
+    const floor = i < 2 ? 0.28 : 0
+    return Math.max(level, floor)
+  })
+}
+
+/** The pad/key/button depth a pressed control sinks to, in model px. */
+export function pressDepth(
+  kind: string,
+  pressed: boolean,
+  hover: boolean,
+): number {
+  const full = kind === 'key' ? 2.6 : kind === 'pad' ? 3.4 : 2.2
+  if (pressed) return -full
+  return hover ? full * 0.3 : 0
+}
+
+/** Pitch bend is −50…50 and rests at 0; mod is 0…100. Both → a 0–1 turn. */
+export function wheelTurn(kind: string, value: number): number {
+  return kind === 'pitch'
+    ? clamp((value + 50) / 100, 0, 1)
+    : clamp(value / 100, 0, 1)
+}
+
+/** Parallax from the pointer's position over the device, in degrees. */
+export function tiltFromPointer(
+  nx: number,
+  ny: number,
+  max = 3.2,
+): { rx: number; ry: number } {
+  return {
+    rx: clamp(ny, -1, 1) * max,
+    ry: clamp(nx, -1, 1) * max,
+  }
+}
+
+/** Read a control's own attributes into a `PartState`. */
+export function readPartAttributes(
+  get: (name: string) => string | null,
+): PartState {
+  const raw = get('aria-valuenow') ?? get('data-v')
+  const value = raw === null || raw === '' ? 0 : Number(raw)
+  return {
+    pressed: get('aria-pressed') === 'true' || get('data-on') === 'true',
+    hit: get('data-hit') === 'true',
+    value: Number.isFinite(value) ? value : 0,
+  }
+}
