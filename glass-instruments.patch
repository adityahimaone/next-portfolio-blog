@@ -0,0 +1,251 @@
+/** @jest-environment node */
+import * as THREE from 'three'
+
+import {
+  buildController,
+  buildRadio,
+} from '@/features/landing-page/components/instrument/instrument-models'
+import type { FrameContext } from '@/features/landing-page/components/instrument/instrument-core'
+import type {
+  Part,
+  PartState,
+} from '@/features/landing-page/components/instrument/instrument-layout'
+
+const part = (id: string, x: number, y: number, w: number, h: number): Part => {
+  const at = id.indexOf(':')
+  return {
+    id,
+    kind: at < 0 ? id : id.slice(0, at),
+    key: at < 0 ? '' : id.slice(at + 1),
+    x,
+    y,
+    w,
+    h,
+  }
+}
+
+const SIZE = { width: 1200, height: 640, radius: 14 }
+
+const controllerParts = (): Part[] => [
+  part('lcd', 280, 24, 520, 130),
+  part('arp', 860, 40, 120, 36),
+  part('pwr', 860, 90, 120, 36),
+  ...Array.from({ length: 6 }, (_, i) =>
+    part(`pad:${i}`, 40 + (i % 3) * 120, 200 + Math.floor(i / 3) * 80, 108, 70),
+  ),
+  ...Array.from({ length: 4 }, (_, i) =>
+    part(`knob:${i}`, 420 + i * 80, 210, 56, 56),
+  ),
+  ...Array.from({ length: 4 }, (_, i) =>
+    part(`fader:${i}`, 760 + i * 70, 190, 30, 140),
+  ),
+  part('bed', 20, 360, 1160, 260),
+  part('wheel:pitch', 40, 380, 40, 200),
+  part('wheel:mod', 100, 380, 40, 200),
+  ...Array.from({ length: 21 }, (_, i) =>
+    part(`key:${i}`, 170 + i * 46, 380, 44, 220),
+  ),
+  ...Array.from({ length: 6 }, (_, i) =>
+    part(`key:${22 + i}`, 195 + i * 92, 380, 28, 130),
+  ),
+]
+
+const frame = (
+  states: Record<string, Partial<PartState>> = {},
+  extra: Partial<FrameContext> = {},
+): FrameContext => ({
+  dt: 1 / 60,
+  time: 0,
+  states: new Map(
+    Object.entries(states).map(([id, s]) => [
+      id,
+      { pressed: false, hit: false, value: 0, ...s },
+    ]),
+  ),
+  hover: null,
+  pressed: null,
+  light: { x: 0, y: 0 },
+  ...extra,
+})
+
+const settle = (
+  scene: ReturnType<typeof buildController>,
+  make: () => FrameContext,
+  max = 600,
+) => {
+  for (let i = 0; i < max; i += 1) if (!scene.update(make())) return i
+  return max
+}
+
+describe('buildController', () => {
+  it('builds a scene from measured parts without a GL context', () => {
+    const scene = buildController(controllerParts(), SIZE)
+    expect(scene.root.children.length).toBeGreaterThan(40)
+    scene.dispose()
+  })
+
+  it('keeps every control inside the shell', () => {
+    const scene = buildController(controllerParts(), SIZE)
+    scene.update(frame())
+    const box = new THREE.Box3()
+    scene.root.children.forEach((child, index) => {
+      if (index === 0) return // the shell itself
+      box.setFromObject(child)
+      expect(box.min.x).toBeGreaterThanOrEqual(-SIZE.width / 2 - 1)
+      expect(box.max.x).toBeLessThanOrEqual(SIZE.width / 2 + 1)
+      expect(box.min.y).toBeGreaterThanOrEqual(-SIZE.height / 2 - 1)
+      expect(box.max.y).toBeLessThanOrEqual(SIZE.height / 2 + 1)
+    })
+    scene.dispose()
+  })
+
+  it('puts a part at its measured position, with y flipped', () => {
+    const scene = buildController([part('pad:0', 0, 0, 100, 60)], SIZE)
+    scene.update(frame())
+    const pad = scene.root.children[1] as THREE.Mesh
+    expect(pad.position.x).toBeCloseTo(-SIZE.width / 2 + 50, 5)
+    expect(pad.position.y).toBeCloseTo(SIZE.height / 2 - 30, 5)
+    scene.dispose()
+  })
+
+  it('lights and sinks a hit pad, then returns it to rest', () => {
+    const scene = buildController([part('pad:0', 100, 100, 100, 60)], SIZE)
+    const pad = scene.root.children[1] as THREE.Mesh
+    const material = pad.material as THREE.MeshStandardMaterial
+    scene.update(frame())
+    const rest = pad.position.z
+
+    for (let i = 0; i < 30; i += 1)
+      scene.update(frame({ 'pad:0': { hit: true } }))
+    expect(material.emissiveIntensity).toBeGreaterThan(1)
+    expect(pad.position.z).toBeLessThan(rest)
+
+    const steps = settle(scene, () => frame())
+    expect(steps).toBeLessThan(600)
+    expect(material.emissiveIntensity).toBe(0)
+    expect(pad.position.z).toBe(rest)
+    scene.dispose()
+  })
+
+  it('turns a knob to its value and stops moving once it gets there', () => {
+    const scene = buildController([part('knob:0', 100, 100, 56, 56)], SIZE)
+    const group = scene.root.children[1] as THREE.Group
+    const cap = group.children[1] as THREE.Group
+    for (let i = 0; i < 400; i += 1)
+      scene.update(frame({ 'knob:0': { value: 100 } }))
+    expect(cap.rotation.z).toBeCloseTo((-125 * Math.PI) / 180, 1)
+    const moving = scene.update(frame({ 'knob:0': { value: 100 } }))
+    expect(moving).toBe(false)
+    scene.dispose()
+  })
+
+  it('dips a pressed key at its front edge and releases it', () => {
+    const parts = [
+      part('key:0', 100, 100, 40, 200),
+      part('key:22', 130, 100, 24, 110),
+    ]
+    const scene = buildController(parts, SIZE)
+    const white = scene.root.children[1] as THREE.Group
+    for (let i = 0; i < 30; i += 1)
+      scene.update(frame({ 'key:0': { pressed: true } }))
+    expect(white.rotation.x).toBeLessThan(0)
+    settle(scene, () => frame())
+    expect(white.rotation.x).toBe(0)
+    scene.dispose()
+  })
+
+  it('tells a black key from a white one by its length', () => {
+    const parts = [
+      part('key:0', 100, 100, 40, 200),
+      part('key:22', 130, 100, 24, 110),
+    ]
+    const scene = buildController(parts, SIZE)
+    const [white, black] = scene.root.children.slice(1) as THREE.Group[]
+    const mat = (g: THREE.Group) =>
+      (
+        (g.children[0] as THREE.Mesh).material as THREE.MeshStandardMaterial
+      ).color.getHex()
+    expect(mat(white)).not.toBe(mat(black))
+    scene.dispose()
+  })
+
+  it('moves a fader cap along its slot and keeps it inside', () => {
+    const scene = buildController([part('fader:0', 100, 100, 30, 140)], SIZE)
+    const cap = scene.root.children[2] as THREE.Mesh
+    for (let i = 0; i < 400; i += 1)
+      scene.update(frame({ 'fader:0': { value: 100 } }))
+    const top = cap.position.y
+    for (let i = 0; i < 400; i += 1)
+      scene.update(frame({ 'fader:0': { value: 0 } }))
+    const bottom = cap.position.y
+    expect(top).toBeGreaterThan(bottom)
+    const slotCentre = SIZE.height / 2 - (100 + 70)
+    expect(top).toBeLessThanOrEqual(slotCentre + 70)
+    expect(bottom).toBeGreaterThanOrEqual(slotCentre - 70)
+    scene.dispose()
+  })
+
+  it('ignores parts it does not know and states it was not given', () => {
+    const scene = buildController([part('mystery:1', 10, 10, 20, 20)], SIZE)
+    expect(() => scene.update(frame())).not.toThrow()
+    scene.dispose()
+  })
+})
+
+const radioParts = (): Part[] => [
+  part('handle', 500, 8, 200, 16),
+  part('face', 30, 80, 1140, 300),
+  part('speaker', 50, 100, 300, 260),
+  part('level', 70, 320, 260, 20),
+  part('lcd', 380, 100, 300, 70),
+  part('scale', 380, 190, 300, 36),
+  part('needle', 400, 190, 3, 36),
+  part('dial:vol', 700, 120, 50, 50),
+  part('dial:tune', 780, 120, 50, 50),
+  part('bay', 380, 250, 780, 120),
+]
+
+describe('buildRadio', () => {
+  it('builds, draws the LEDs forever, and disposes cleanly', () => {
+    const scene = buildRadio(radioParts(), SIZE)
+    // The LEDs breathe, so the radio always asks for another frame while it is
+    // on screen; the host's visibility gate is what stops the loop offscreen.
+    expect(scene.update(frame())).toBe(true)
+    expect(() => scene.dispose()).not.toThrow()
+  })
+
+  it('slides the needle to its station and turns the tune dial', () => {
+    const scene = buildRadio(radioParts(), SIZE)
+    const states = { needle: { value: 92 }, 'dial:tune': { value: 405 } }
+    for (let i = 0; i < 600; i += 1)
+      scene.update(frame(states, { time: i / 60 }))
+    const needle = scene.root.children.find(
+      (c) =>
+        (c as THREE.Mesh).isMesh &&
+        Math.abs(c.position.x - (380 - SIZE.width / 2 + 0.92 * 300)) < 2,
+    )
+    expect(needle).toBeDefined()
+    scene.dispose()
+  })
+
+  it('lights the LEDs harder while the speaker is being pressed', () => {
+    const lit = (pressed: string | null) => {
+      const scene = buildRadio(radioParts(), SIZE)
+      for (let i = 0; i < 120; i += 1)
+        scene.update(frame({}, { time: i / 60, pressed }))
+      let total = 0
+      scene.root.traverse((object) => {
+        const material = (object as THREE.Mesh)
+          .material as THREE.MeshStandardMaterial
+        if (
+          material?.emissive &&
+          object.position.y === SIZE.height / 2 - (320 + 10)
+        )
+          total += material.emissiveIntensity
+      })
+      scene.dispose()
+      return total
+    }
+    expect(lit('speaker')).toBeGreaterThan(lit(null))
+  })
+})
