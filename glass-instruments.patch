diff --git a/features/landing-page/components/instrument/instrument-core.ts b/features/landing-page/components/instrument/instrument-core.ts
new file mode 100644
index 0000000..1e55d20
--- /dev/null
+++ b/features/landing-page/components/instrument/instrument-core.ts
@@ -0,0 +1,390 @@
+import * as THREE from 'three'
+import { RoomEnvironment } from 'three/examples/jsm/environments/RoomEnvironment.js'
+
+import {
+  approach,
+  parseId,
+  readPartAttributes,
+  relativeRect,
+  tiltFromPointer,
+  type Part,
+  type PartState,
+} from './instrument-layout'
+
+/**
+ * The glass-instrument renderer: a three.js surface layer behind live DOM.
+ *
+ * See `instrument-layout.ts` for the idea. This file is the machinery:
+ * measure the DOM controls, hand their rectangles to a scene builder, render
+ * the scene into a canvas that sits *behind* the host's children, and keep it
+ * in step with the DOM by reading attributes rather than being told anything.
+ *
+ * ## Why it is built like this
+ *
+ * - **A canvas behind, not a canvas instead.** The host's controls stay where
+ *   they are, with their own focus, keyboard and audio handlers. The canvas is
+ *   `pointer-events: none` at `z-index: -1` inside an isolated host, so it
+ *   paints above the host's own background and below every child. The host's
+ *   background is made transparent by CSS only once a first frame is on the
+ *   canvas (`data-instrument="on"`), so a failed start leaves the DOM exactly
+ *   as it was authored.
+ * - **Orthographic, in host pixels.** One model unit is one CSS pixel, and the
+ *   camera frames the host exactly. A control's model position is its measured
+ *   rectangle, so there is no layout to keep in sync and nothing to drift.
+ * - **Render on demand.** The loop runs while something is moving (a press, a
+ *   settling knob, the pointer's parallax) and goes to sleep when everything
+ *   has landed. A page at rest draws nothing, and a host that is off screen
+ *   draws nothing even while its DOM changes.
+ * - **Its own context, bounded.** The About devices share one off-screen
+ *   renderer because there are a dozen of them. There are two instruments and
+ *   one is on screen at a time, so each gets a context of its own with a capped
+ *   pixel ratio, and gives it back when it leaves the page.
+ * - **It can fail.** No WebGL, a lost context, a thrown build: `mountInstrument`
+ *   returns `null` or tears itself down and the DOM device is what remains.
+ */
+
+export type FrameContext = {
+  dt: number
+  time: number
+  states: ReadonlyMap<string, PartState>
+  hover: string | null
+  pressed: string | null
+  /** The light, as a −1…1 position over the device. */
+  light: { x: number; y: number }
+}
+
+export type InstrumentScene = {
+  /** Centred on the origin, in host pixels, y up. */
+  root: THREE.Group
+  /** Advance by `dt` seconds; return true while anything is still moving. */
+  update: (frame: FrameContext) => boolean
+  dispose: () => void
+}
+
+export type SceneBuilder = (
+  parts: Part[],
+  size: { width: number; height: number; radius: number },
+) => InstrumentScene
+
+export type Instrument = {
+  /** Re-read the DOM and draw. Cheap; coalesced into the next frame. */
+  refresh: () => void
+  dispose: () => void
+}
+
+/** Overscan around the host, so a tilted shell's walls are not clipped. */
+export const OVERSCAN = 24
+
+/** The attributes the scenes read, which is what wakes the renderer. */
+const WATCHED = [
+  'aria-pressed',
+  'aria-valuenow',
+  'aria-selected',
+  'data-v',
+  'data-hit',
+  'data-on',
+]
+
+/** The resting pose: far enough off axis that the shell shows its thickness. */
+const REST_TILT = { rx: -5, ry: 3.5 }
+
+export function mountInstrument(
+  host: HTMLElement,
+  build: SceneBuilder,
+): Instrument | null {
+  if (typeof WebGLRenderingContext === 'undefined') return null
+
+  const canvas = document.createElement('canvas')
+  canvas.setAttribute('aria-hidden', 'true')
+  canvas.dataset.instrumentCanvas = ''
+  canvas.style.cssText = [
+    'position:absolute',
+    `inset:-${OVERSCAN}px`,
+    `width:calc(100% + ${OVERSCAN * 2}px)`,
+    `height:calc(100% + ${OVERSCAN * 2}px)`,
+    'z-index:-1',
+    'pointer-events:none',
+    'display:block',
+  ].join(';')
+
+  let renderer: THREE.WebGLRenderer
+  try {
+    renderer = new THREE.WebGLRenderer({
+      canvas,
+      antialias: true,
+      alpha: true,
+      powerPreference: 'low-power',
+    })
+  } catch {
+    return null
+  }
+  renderer.setClearColor(0x000000, 0)
+  renderer.toneMapping = THREE.ACESFilmicToneMapping
+  renderer.toneMappingExposure = 1.05
+  renderer.outputColorSpace = THREE.SRGBColorSpace
+
+  const pmrem = new THREE.PMREMGenerator(renderer)
+  const env = pmrem.fromScene(new RoomEnvironment(), 0.04).texture
+  pmrem.dispose()
+
+  const three = new THREE.Scene()
+  three.environment = env
+  const stage = new THREE.Group()
+  three.add(stage)
+
+  // The one moving light. Glass is lit by the environment; a point of key light
+  // is what puts a glint on a rounded key edge and lets it follow the pointer.
+  const key = new THREE.DirectionalLight(0xfff4e6, 1.15)
+  three.add(key)
+  three.add(key.target)
+
+  const camera = new THREE.OrthographicCamera(-1, 1, 1, -1, -3000, 3000)
+  camera.position.z = 1000
+
+  let scene: InstrumentScene | null = null
+  let parts: Part[] = []
+  const states = new Map<string, PartState>()
+  let width = 0
+  let height = 0
+  let hover: string | null = null
+  let pressed: string | null = null
+  let visible = true
+  let alive = true
+  let raf = 0
+  let last = 0
+  let time = 0
+  let tilt = { rx: REST_TILT.rx, ry: REST_TILT.ry }
+  let tiltTarget = { rx: REST_TILT.rx, ry: REST_TILT.ry }
+  let light = { x: -0.4, y: 0.6 }
+  let lightTarget = { x: -0.4, y: 0.6 }
+  let statesDirty = true
+  let layoutDirty = true
+
+  const nodes = () =>
+    Array.from(host.querySelectorAll<HTMLElement>('[data-i3d]'))
+
+  const measure = () => {
+    const hostBox = host.getBoundingClientRect()
+    const layoutWidth = host.offsetWidth
+    const next: Part[] = []
+    for (const node of nodes()) {
+      const id = node.dataset.i3d ?? ''
+      const box = node.getBoundingClientRect()
+      const rect = relativeRect(
+        { x: box.left, y: box.top, w: box.width, h: box.height },
+        {
+          x: hostBox.left,
+          y: hostBox.top,
+          w: hostBox.width,
+          h: hostBox.height,
+        },
+        layoutWidth,
+      )
+      if (!rect || rect.w < 1 || rect.h < 1) continue
+      next.push({ ...rect, id, ...parseId(id) })
+    }
+    parts = next
+    width = host.offsetWidth
+    height = host.offsetHeight
+  }
+
+  const readStates = () => {
+    states.clear()
+    for (const node of nodes()) {
+      const id = node.dataset.i3d ?? ''
+      states.set(
+        id,
+        readPartAttributes((name) => node.getAttribute(name)),
+      )
+    }
+  }
+
+  const rebuild = () => {
+    measure()
+    if (width < 2 || height < 2) return false
+    scene?.dispose()
+    stage.clear()
+    const radius = parseFloat(getComputedStyle(host).borderTopLeftRadius) || 14
+    scene = build(parts, { width, height, radius })
+    stage.add(scene.root)
+
+    const w = width + OVERSCAN * 2
+    const h = height + OVERSCAN * 2
+    renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 1.5))
+    renderer.setSize(w, h, false)
+    camera.left = -w / 2
+    camera.right = w / 2
+    camera.top = h / 2
+    camera.bottom = -h / 2
+    camera.updateProjectionMatrix()
+    layoutDirty = false
+    return true
+  }
+
+  const schedule = () => {
+    if (raf || !alive || !visible) return
+    raf = requestAnimationFrame(frame)
+  }
+
+  const frame = (now: number) => {
+    raf = 0
+    if (!alive || !visible) return
+    if (layoutDirty && !rebuild()) return
+    if (statesDirty) {
+      readStates()
+      statesDirty = false
+    }
+    const dt = last ? Math.min(0.05, (now - last) / 1000) : 1 / 60
+    last = now
+    time += dt
+
+    tilt = {
+      rx: approach(tilt.rx, tiltTarget.rx, 9, dt, 0.01),
+      ry: approach(tilt.ry, tiltTarget.ry, 9, dt, 0.01),
+    }
+    light = {
+      x: approach(light.x, lightTarget.x, 8, dt, 0.002),
+      y: approach(light.y, lightTarget.y, 8, dt, 0.002),
+    }
+    stage.rotation.x = (tilt.rx * Math.PI) / 180
+    stage.rotation.y = (tilt.ry * Math.PI) / 180
+    key.position.set(light.x * 700, light.y * 500, 600)
+
+    const moving = scene
+      ? scene.update({ dt, time, states, hover, pressed, light })
+      : false
+    renderer.render(three, camera)
+
+    const settling =
+      tilt.rx !== tiltTarget.rx ||
+      tilt.ry !== tiltTarget.ry ||
+      light.x !== lightTarget.x ||
+      light.y !== lightTarget.y
+    if (moving || settling) schedule()
+    else last = 0
+  }
+
+  const refresh = () => {
+    statesDirty = true
+    schedule()
+  }
+
+  /* ── Wiring ─────────────────────────────────────────────── */
+
+  const idAt = (target: EventTarget | null) => {
+    const node = (target as Element | null)?.closest?.('[data-i3d]')
+    return (node as HTMLElement | null)?.dataset.i3d ?? null
+  }
+
+  const onMove = (event: PointerEvent) => {
+    const box = host.getBoundingClientRect()
+    if (box.width < 1 || box.height < 1) return
+    const nx = ((event.clientX - box.left) / box.width) * 2 - 1
+    const ny = ((event.clientY - box.top) / box.height) * 2 - 1
+    const offset = tiltFromPointer(nx, ny, 2.4)
+    tiltTarget = {
+      rx: REST_TILT.rx + offset.rx,
+      ry: REST_TILT.ry + offset.ry,
+    }
+    lightTarget = { x: nx, y: -ny }
+    const id = idAt(event.target)
+    if (id !== hover) hover = id
+    schedule()
+  }
+  const onLeave = () => {
+    hover = null
+    tiltTarget = { ...REST_TILT }
+    lightTarget = { x: -0.4, y: 0.6 }
+    schedule()
+  }
+  const onDown = (event: PointerEvent) => {
+    pressed = idAt(event.target)
+    schedule()
+  }
+  const onUp = () => {
+    if (pressed === null) return
+    pressed = null
+    schedule()
+  }
+
+  host.addEventListener('pointermove', onMove, { passive: true })
+  host.addEventListener('pointerleave', onLeave, { passive: true })
+  host.addEventListener('pointerdown', onDown, { passive: true })
+  window.addEventListener('pointerup', onUp, { passive: true })
+  window.addEventListener('pointercancel', onUp, { passive: true })
+
+  const mutations = new MutationObserver(refresh)
+  mutations.observe(host, {
+    attributes: true,
+    attributeFilter: WATCHED,
+    subtree: true,
+  })
+
+  const resize = new ResizeObserver(() => {
+    layoutDirty = true
+    statesDirty = true
+    schedule()
+  })
+  resize.observe(host)
+
+  const io = new IntersectionObserver((entries) => {
+    visible = entries[0] ? entries[0].isIntersecting : true
+    if (visible) {
+      statesDirty = true
+      schedule()
+    }
+  })
+  io.observe(host)
+
+  const dispose = () => {
+    if (!alive) return
+    alive = false
+    cancelAnimationFrame(raf)
+    host.removeEventListener('pointermove', onMove)
+    host.removeEventListener('pointerleave', onLeave)
+    host.removeEventListener('pointerdown', onDown)
+    window.removeEventListener('pointerup', onUp)
+    window.removeEventListener('pointercancel', onUp)
+    mutations.disconnect()
+    resize.disconnect()
+    io.disconnect()
+    scene?.dispose()
+    env.dispose()
+    renderer.dispose()
+    renderer.forceContextLoss()
+    canvas.remove()
+    delete host.dataset.instrument
+  }
+
+  canvas.addEventListener('webglcontextlost', (event) => {
+    // The DOM device is still there; hand it back.
+    event.preventDefault()
+    dispose()
+  })
+
+  try {
+    host.prepend(canvas)
+    if (!rebuild()) {
+      dispose()
+      return null
+    }
+    readStates()
+    statesDirty = false
+    ;(scene as InstrumentScene | null)?.update({
+      dt: 1 / 60,
+      time: 0,
+      states,
+      hover: null,
+      pressed: null,
+      light,
+    })
+    renderer.render(three, camera)
+    host.dataset.instrument = 'on'
+  } catch (error) {
+    console.error('Glass instrument: could not start', error)
+    dispose()
+    return null
+  }
+
+  return { refresh, dispose }
+}
