{
  "name": "portfolio-2026",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node -e \"const fs=require('fs'); fs.rmSync('.next', {recursive: true, force: true});\"",
    "generate:content": "node scripts/generate-blog-content.mjs",
    "build": "node scripts/generate-blog-content.mjs && next build",
    "build:standalone": "CF_DEPLOY=1 node scripts/generate-blog-content.mjs && next build && node scripts/prepare-standalone.mjs",
    "start": "next start",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "lint": "eslint .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:e2e": "playwright test"
  },
  "browserslist": [
    "chrome >= 109",
    "edge >= 109",
    "firefox >= 110",
    "safari >= 16",
    "not dead"
  ],
  "dependencies": {
    "@radix-ui/react-slider": "1.2.3",
    "clsx": "2.1.1",
    "gray-matter": "4.0.3",
    "gsap": "^3.15.0",
    "lenis": "1.3.25",
    "lucide-react": "0.468.0",
    "motion": "12.38.0",
    "next": "16.3.7",
    "next-themes": "0.4.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "reading-time": "1.5.0",
    "remark-gfm": "^4.0.1",
    "schema-dts": "^2.0.0",
    "tailwind-merge": "2.6.0",
    "tone": "15.1.22"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3",
    "@next/bundle-analyzer": "^16.2.4",
    "@opennextjs/cloudflare": "^1.20.7",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "4.2.2",
    "@tailwindcss/typography": "0.5.19",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/node": "20",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "eslint": "9",
    "eslint-config-next": "16.3.6",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-mdx": "^3.8.1",
    "eslint-plugin-prettier": "5.5.4",
    "fast-check": "^4.7.0",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "postcss": "^8.5.10",
    "prettier": "3.4.2",
    "prettier-plugin-tailwindcss": "0.6.10",
    "tailwindcss": "4.2.2",
    "ts-jest": "^29.4.9",
    "typescript": "5",
    "wrangler": "^4.146.0"
  }
}
