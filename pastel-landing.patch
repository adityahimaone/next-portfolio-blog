+'use client'
+
+import { motion } from 'motion/react'
+import { ArrowUpRight, RotateCcw } from 'lucide-react'
+import { CONTACT_HREF, PASTEL, SOCIALS } from './studio-data'
+
+type Props = { onReplay: () => void }
+
+export function EndOfTrack({ onReplay }: Props) {
+  return (
+    <footer
+      id="outro"
+      className="flex min-h-[80svh] flex-col justify-between px-5 pt-28 pb-28 sm:px-10"
+      style={{
+        background: `linear-gradient(180deg, ${PASTEL.cream}, ${PASTEL.lilac} 55%, ${PASTEL.pink})`,
+      }}
+    >
+      <div>
+        <p className="mb-3 font-mono text-xs tracking-[0.2em] uppercase opacity-60">
+          03 · End of track
+        </p>
+        <h2 className="font-(family-name:--deck-font-display) text-[clamp(2.4rem,7vw,6.5rem)] leading-[0.95] font-semibold tracking-[-0.04em]">
+          Got something
+          <br />
+          worth <span className="text-[#ff7a59]">building?</span>
+        </h2>
+        <a
+          href={CONTACT_HREF}
+          className="mt-10 inline-flex items-center gap-2 rounded-full bg-[#2b2540] px-6 py-3.5 text-sm font-medium text-[#fff3e6] transition-transform active:scale-95"
+        >
+          Say hello <ArrowUpRight size={16} />
+        </a>
+      </div>
+
+      <div className="mt-20 flex flex-wrap items-end justify-between gap-6 border-t border-[#2b2540]/20 pt-6">
+        <ul className="flex gap-6 font-mono text-xs tracking-widest uppercase">
+          {SOCIALS.map((social) => (
+            <li key={social.label}>
+              <a
+                href={social.href}
+                target="_blank"
+                rel="noopener noreferrer"
+                className="opacity-70 transition-opacity hover:opacity-100"
+              >
+                {social.label}
+              </a>
+            </li>
+          ))}
+        </ul>
+        <motion.button
+          type="button"
+          onClick={onReplay}
+          whileTap={{ scale: 0.94 }}
+          className="inline-flex items-center gap-2 rounded-full border border-black/15 px-5 py-2.5 font-mono text-xs tracking-widest text-[#141412] uppercase transition-colors hover:border-[#ff5b1f] hover:text-[#ff7a59]"
+        >
+          <RotateCcw size={14} /> Replay from 00:00
+        </motion.button>
+      </div>
+    </footer>
+  )
+}
