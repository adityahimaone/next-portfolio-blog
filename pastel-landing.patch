+                      style={{ background: color }}
+                    >
+                      <div className="relative aspect-square w-40 overflow-hidden rounded-2xl bg-white/50 sm:w-full">
+                        {project.cover ? (
+                          <Image
+                            src={project.cover}
+                            alt={`${project.title} cover art`}
+                            fill
+                            sizes="220px"
+                            className="object-cover"
+                          />
+                        ) : null}
+                      </div>
+                      <div className="flex flex-col justify-between gap-5">
+                        <div>
+                          <p className="max-w-xl text-sm leading-relaxed opacity-80">
+                            {project.description}
+                          </p>
+                          <p className="mt-3 font-mono text-[11px] tracking-wider uppercase opacity-60">
+                            {project.role}
+                          </p>
+                        </div>
+                        <ul className="flex flex-wrap gap-2">
+                          {project.stack.map((tech) => (
+                            <li
+                              key={tech}
+                              className="rounded-full border border-[#2b2540]/25 bg-white/50 px-3 py-1 font-mono text-[11px] opacity-80"
+                            >
+                              {tech}
+                            </li>
+                          ))}
+                        </ul>
+                        <Link
+                          href={`/projects/${project.slug}`}
+                          className="inline-flex w-fit items-center gap-1.5 text-sm font-medium underline-offset-4 hover:underline"
+                        >
+                          Read the liner notes <ArrowUpRight size={15} />
+                        </Link>
+                      </div>
+                    </div>
+                  </motion.div>
+                ) : null}
+              </AnimatePresence>
+            </li>
+          )
+        })}
+      </ol>
+
+      <Link
+        href="/projects"
+        className="mt-8 inline-flex items-center gap-1.5 font-mono text-xs tracking-widest text-black/60 uppercase transition-colors hover:text-black"
+      >
+        Full discography <ArrowUpRight size={14} />
+      </Link>
+    </section>
+  )
+}
