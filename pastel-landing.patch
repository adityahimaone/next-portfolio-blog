@@ -0,0 +1,92 @@
+'use client'
+
+import { motion } from 'motion/react'
+import { PASTEL, STEMS, seeded } from './studio-data'
+
+const BARS = 36
+const RULER = Array.from({ length: 16 }, (_, i) => i + 1)
+
+const GRID = `repeating-linear-gradient(90deg, rgb(43 37 64 / 0.09) 0 1px, transparent 1px calc(100% / 16))`
+
+/** The hero's language, continued: lanes, a bar ruler and clips with length. */
+export function AboutLanes({ reduced }: { reduced: boolean }) {
+  return (
+    <section
+      id="about"
+      className="px-5 py-28 sm:px-10"
+      style={{ background: PASTEL.paper }}
+    >
+      <p className="mb-3 font-mono text-xs tracking-[0.2em] uppercase opacity-60">
+        01 · Profile
+      </p>
+      <h2 className="mb-12 max-w-3xl font-(family-name:--deck-font-display) text-[clamp(1.9rem,4.6vw,3.8rem)] leading-[1.02] font-semibold tracking-[-0.03em]">
+        A design engineer works on every lane at once.
+      </h2>
+
+      <div className="overflow-hidden rounded-3xl border border-[#2b2540]/15 bg-white/60">
+        <div
+          className="grid grid-cols-16 border-b border-[#2b2540]/15 px-0 py-2 font-mono text-[10px] opacity-60"
+          aria-hidden
+        >
+          {RULER.map((n) => (
+            <span key={n} className="pl-2">
+              {n.toString().padStart(2, '0')}
+            </span>
+          ))}
+        </div>
+        {STEMS.map((stem) => (
+          <motion.div
+            key={stem.id}
+            initial={reduced ? false : 'hidden'}
+            whileInView="shown"
+            viewport={{ once: true, margin: '-12% 0px' }}
+            className="relative border-b border-[#2b2540]/10 p-3 last:border-b-0 md:h-36 md:p-0"
+            style={{ backgroundImage: GRID }}
+          >
+            <motion.div
+              className="flex h-full flex-col justify-between gap-3 rounded-2xl border border-[#2b2540]/20 p-4 shadow-[0_6px_0_-2px_rgba(43,37,64,0.12)] md:absolute md:top-3 md:bottom-3 md:left-(--s) md:w-(--w)"
+              style={
+                {
+                  background: stem.color,
+                  '--s': stem.start,
+                  '--w': stem.width,
+                  transformOrigin: 'left center',
+                } as React.CSSProperties
+              }
+              variants={{
+                hidden: { scaleX: 0, opacity: 0 },
+                shown: {
+                  scaleX: 1,
+                  opacity: 1,
+                  transition: {
+                    type: 'spring',
+                    stiffness: 140,
+                    damping: 20,
+                  },
+                },
+              }}
+            >
+              <div className="flex flex-col gap-1 md:flex-row md:items-baseline md:gap-4">
+                <h3 className="font-mono text-xs tracking-widest uppercase">
+                  {stem.label}
+                </h3>
+                <p className="text-sm leading-snug opacity-75">{stem.line}</p>
+              </div>
+              <div className="flex h-8 items-end gap-[2px]" aria-hidden>
+                {Array.from({ length: BARS }, (_, i) => (
+                  <span
+                    key={i}
+                    className="w-full rounded-full bg-[#2b2540]/35"
+                    style={{
+                      height: `${(0.2 + seeded(stem.seed, i) * 0.8) * 100}%`,
+                    }}
+                  />
+                ))}
+              </div>
+            </motion.div>
+          </motion.div>
+        ))}
+      </div>
+    </section>
+  )
+}
