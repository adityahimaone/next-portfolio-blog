+'use client'
+
+import { motion, useTransform } from 'motion/react'
+import type { MotionValue } from 'motion/react'
+import { Pause, Play, Repeat } from 'lucide-react'
+import { CHAPTERS, formatBar, formatTimecode } from './studio-data'
+
+type Props = {
+  progress: MotionValue<number>
+  bpm: MotionValue<number>
+  marks: readonly number[]
+  visible: boolean
+  playing: boolean
+  loop: boolean
+  onTogglePlay: () => void
+  onToggleLoop: () => void
+  onSeek: (chapterId: string) => void
+}
+
+/** The page's playhead: timecode, bar, tempo and a scrubbable chapter strip. */
+export function Transport({
+  progress,
+  bpm,
+  marks,
+  visible,
+  playing,
+  loop,
+  onTogglePlay,
+  onToggleLoop,
+  onSeek,
+}: Props) {
+  const timecode = useTransform(progress, formatTimecode)
+  const bar = useTransform(progress, formatBar)
+  const bpmText = useTransform(bpm, (v) => Math.round(v).toString())
+  const playheadLeft = useTransform(progress, (v) => `${v * 100}%`)
+
+  return (
+    <div
+      className={`pointer-events-none fixed inset-x-0 top-3 z-40 flex justify-center px-3 transition-all duration-500 ${
+        visible ? 'translate-y-0 opacity-100' : '-translate-y-16 opacity-0'
+      }`}
+      aria-hidden={!visible}
+      inert={!visible}
+    >
+      <div className="pointer-events-auto flex w-full max-w-2xl items-center gap-3 rounded-full border border-[#2b2540]/15 bg-[#fffaf4]/90 py-1.5 pr-4 pl-1.5 shadow-[0_8px_30px_-12px_rgba(0,0,0,0.25)] backdrop-blur-md">
+        <button
+          type="button"
+          onClick={onTogglePlay}
+          aria-label={
+            playing ? 'Pause auto-scroll' : 'Play: auto-scroll the page'
+          }
+          aria-pressed={playing}
+          className="grid size-9 shrink-0 place-items-center rounded-full bg-[#2b2540] text-[#fff3e6] transition-transform active:scale-95"
+        >
+          {playing ? (
+            <Pause size={15} />
+          ) : (
+            <Play size={15} className="translate-x-px" />
+          )}
+        </button>
+        <button
+          type="button"
+          onClick={onToggleLoop}
+          aria-label="Loop back to the top at the end"
+          aria-pressed={loop}
+          className={`grid size-8 shrink-0 place-items-center rounded-full transition-colors ${
+            loop
+              ? 'bg-[#ff7a59] text-white'
+              : 'text-[#2b2540]/50 hover:text-[#2b2540]'
+          }`}
+        >
+          <Repeat size={14} />
+        </button>
+
+        <div
+          className="relative h-6 min-w-0 flex-1"
+          role="group"
+          aria-label="Chapters"
+        >
+          <div className="absolute inset-x-0 top-1/2 h-px -translate-y-1/2 bg-[#2b2540]/15" />
+          <motion.div
+            className="absolute inset-x-0 top-1/2 h-px origin-left -translate-y-1/2 bg-[#ff7a59]"
+            style={{ scaleX: progress }}
+          />
+          {CHAPTERS.map((chapter, i) => (
+            <button
+              key={chapter.id}
+              type="button"
+              onClick={() => onSeek(chapter.id)}
+              aria-label={`Jump to ${chapter.label}`}
+              title={chapter.label}
+              className="group absolute top-0 h-full w-4 -translate-x-1/2 outline-offset-2"
+              style={{ left: `${(marks[i] ?? 0) * 100}%` }}
+            >
+              <span className="absolute top-1/2 left-1/2 h-3 w-px -translate-x-1/2 -translate-y-1/2 bg-[#2b2540]/40 transition-all group-hover:h-5 group-hover:bg-[#ff7a59]" />
+            </button>
+          ))}
+          <motion.div
+            className="pointer-events-none absolute top-1/2 left-0 size-2.5 -translate-x-1/2 -translate-y-1/2 rounded-full bg-[#ff7a59] shadow-[0_0_0_3px_rgba(255,122,89,0.25)]"
+            style={{ left: playheadLeft }}
+          />
+        </div>
+
+        <div className="hidden shrink-0 items-center gap-3 font-mono text-[11px] tracking-wider text-[#2b2540]/60 tabular-nums sm:flex">
+          <motion.span className="text-[#2b2540]">{timecode}</motion.span>
+          <span>
+            BAR <motion.span>{bar}</motion.span>
+          </span>
+          <span>
+            <motion.span>{bpmText}</motion.span> BPM
+          </span>
+        </div>
+      </div>
+    </div>
+  )
+}
