@@ -0,0 +1,173 @@
+'use client'
+
+import Image from 'next/image'
+import Link from 'next/link'
+import { AnimatePresence, motion } from 'motion/react'
+import { ArrowUpRight, Pause, Play } from 'lucide-react'
+import { useState } from 'react'
+import { TRACK_COLORS, PASTEL } from './studio-data'
+import {
+  WORK_PROJECTS,
+  formatProjectTime,
+  trackLabel,
+  PROJECT_PREVIEW_DURATION,
+} from '@/data/projects'
+
+/** Four bars that move only while a track is "playing". */
+function Eq({ on, color }: { on: boolean; color: string }) {
+  return (
+    <span className="flex h-4 items-end gap-[2px]" aria-hidden>
+      {[0, 1, 2, 3].map((i) => (
+        <motion.span
+          key={i}
+          className="w-[3px] rounded-full"
+          style={{ background: color, height: 4 }}
+          animate={on ? { height: [4, 16, 7, 14, 4] } : { height: 4 }}
+          transition={
+            on
+              ? {
+                  duration: 0.9 + i * 0.13,
+                  repeat: Infinity,
+                  ease: 'easeInOut',
+                }
+              : { duration: 0.2 }
+          }
+        />
+      ))}
+    </span>
+  )
+}
+
+export function SelectedTracks({ reduced }: { reduced: boolean }) {
+  const [open, setOpen] = useState<number>(0)
+  const [playing, setPlaying] = useState<number | null>(null)
+
+  return (
+    <section
+      id="tracks"
+      className="px-5 py-28 sm:px-10"
+      style={{ background: PASTEL.cream }}
+    >
+      <p className="mb-3 font-mono text-xs tracking-[0.2em] uppercase opacity-60">
+        02 · Selected tracks
+      </p>
+      <h2 className="mb-14 max-w-2xl font-(family-name:--deck-font-display) text-[clamp(1.9rem,4.6vw,3.8rem)] leading-[1.02] font-semibold tracking-[-0.03em]">
+        Design engineering, one track at a time.
+      </h2>
+
+      <ol className="border-t border-[#2b2540]/15">
+        {WORK_PROJECTS.map((project, index) => {
+          const isOpen = open === index
+          const isPlaying = playing === index
+          const color = TRACK_COLORS[index % TRACK_COLORS.length]
+          return (
+            <li key={project.slug} className="border-b border-[#2b2540]/15">
+              <div
+                className="grid cursor-pointer grid-cols-[2.5rem_1fr_auto] items-center gap-3 py-5 sm:grid-cols-[3.5rem_1fr_9rem_auto]"
+                onMouseEnter={() => setOpen(index)}
+              >
+                <button
+                  type="button"
+                  aria-label={`${isPlaying ? 'Pause' : 'Play'} ${project.title}`}
+                  aria-pressed={isPlaying}
+                  onClick={() => setPlaying(isPlaying ? null : index)}
+                  className="grid size-10 place-items-center rounded-full border border-[#2b2540]/25 transition-all hover:scale-105 active:scale-90"
+                  style={{ background: isPlaying ? PASTEL.coral : color }}
+                >
+                  {isPlaying ? (
+                    <Pause size={14} />
+                  ) : (
+                    <Play size={14} className="translate-x-px" />
+                  )}
+                </button>
+                <button
+                  type="button"
+                  aria-expanded={isOpen}
+                  onClick={() => setOpen(isOpen ? -1 : index)}
+                  className="min-w-0 text-left"
+                >
+                  <span className="mr-3 font-mono text-[11px] opacity-50">
+                    {trackLabel(index)}
+                  </span>
+                  <span className="text-xl font-medium tracking-tight sm:text-3xl">
+                    {project.title}
+                  </span>
+                </button>
+                <span className="hidden font-mono text-[11px] tracking-wider uppercase opacity-60 sm:block">
+                  {project.genre} · {project.year}
+                </span>
+                <span className="flex items-center gap-3 font-mono text-[11px] tabular-nums opacity-60">
+                  <Eq on={isPlaying} color={PASTEL.coral} />
+                  {formatProjectTime(PROJECT_PREVIEW_DURATION)}
+                </span>
+              </div>
+
+              <AnimatePresence initial={false}>
+                {isOpen ? (
+                  <motion.div
+                    key="panel"
+                    initial={reduced ? false : { height: 0, opacity: 0 }}
+                    animate={{ height: 'auto', opacity: 1 }}
+                    exit={{ height: 0, opacity: 0 }}
+                    transition={{ type: 'spring', stiffness: 220, damping: 30 }}
+                    className="overflow-hidden"
+                  >
+                    <div
