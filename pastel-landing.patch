@@ -0,0 +1,102 @@
+/**
+ * The page is one track. Its length is a fiction, but a consistent one: every
+ * readout (timecode, bar, tempo) is derived from scroll progress through this
+ * single constant, so the transport and the sections can never disagree.
+ */
+export const TRACK_SECONDS = 150
+export const BASE_BPM = 120
+export const BEATS_PER_BAR = 4
+
+export const CHAPTERS = [
+  { id: 'intro', label: 'Intro' },
+  { id: 'about', label: 'Profile' },
+  { id: 'tracks', label: 'Tracks' },
+  { id: 'outro', label: 'End' },
+] as const
+
+export type ChapterId = (typeof CHAPTERS)[number]['id']
+
+/** The page's pastel palette. The hero carries the same values in its CSS. */
+export const PASTEL = {
+  cream: '#fff3e6',
+  paper: '#fffaf4',
+  ink: '#2b2540',
+  muted: '#7a7494',
+  coral: '#ff7a59',
+  peach: '#ffd2c0',
+  butter: '#ffe8a3',
+  mint: '#c5ecd3',
+  sky: '#bfe0ff',
+  lilac: '#dccbff',
+  pink: '#ffc9e0',
+} as const
+
+export const TRACK_COLORS = [
+  PASTEL.peach,
+  PASTEL.butter,
+  PASTEL.mint,
+  PASTEL.sky,
+  PASTEL.lilac,
+  PASTEL.pink,
+] as const
+
+/** Each stem is a clip on a lane: where it starts and how long it runs. */
+export const STEMS = [
+  {
+    id: 'design',
+    label: 'Design',
+    line: 'Hierarchy, spacing and type decided in the browser, not handed over as a mockup.',
+    seed: 3,
+    color: PASTEL.pink,
+    start: '2%',
+    width: '74%',
+  },
+  {
+    id: 'motion',
+    label: 'Motion',
+    line: 'Springs, scroll-linked timing and micro-interactions that explain what the interface is doing.',
+    seed: 7,
+    color: PASTEL.butter,
+    start: '16%',
+    width: '78%',
+  },
+  {
+    id: 'engineering',
+    label: 'Engineering',
+    line: 'Next.js and TypeScript with the performance and accessibility work left in, not cut.',
+    seed: 11,
+    color: PASTEL.mint,
+    start: '8%',
+    width: '86%',
+  },
+] as const
+
+export const SOCIALS = [
+  { label: 'GitHub', href: 'https://github.com/adityahimaone' },
+  { label: 'LinkedIn', href: 'https://linkedin.com/in/adityahimaone' },
+  { label: 'X', href: 'https://x.com/adityahimaone' },
+] as const
+
+export const CONTACT_HREF = 'mailto:adityahimaone@gmail.com'
+
+export function formatTimecode(progress: number): string {
+  const total = Math.max(0, Math.min(1, progress)) * TRACK_SECONDS
+  const m = Math.floor(total / 60)
+  const s = Math.floor(total % 60)
+  const f = Math.floor((total % 1) * 100)
+  return `${m.toString().padStart(2, '0')}:${s
+    .toString()
+    .padStart(2, '0')}.${f.toString().padStart(2, '0')}`
+}
+
+export function formatBar(progress: number): string {
+  const seconds = Math.max(0, Math.min(1, progress)) * TRACK_SECONDS
+  const bar = Math.floor(seconds / ((60 / BASE_BPM) * BEATS_PER_BAR)) + 1
+  return bar.toString().padStart(3, '0')
+}
+
+/** Deterministic 0..1 noise, so a stem's waveform is the same on every render. */
+export function seeded(seed: number, index: number): number {
+  const x = Math.sin(seed * 127.1 + index * 311.7) * 43758.5453
+  return x - Math.floor(x)
+}
