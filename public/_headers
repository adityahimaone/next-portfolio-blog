# Cloudflare Workers static asset caching.
# Without this, hashed build assets are served with no caching headers and
# every visitor re-downloads the whole JS bundle.

/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/*.woff2
  Cache-Control: public, max-age=31536000, immutable

/*.svg
  Cache-Control: public, max-age=86400