index 0000000..f4df1e7
--- /dev/null
+++ b/features/landing-page/rack-01/contact-desk/scene-engine.ts
@@ -0,0 +1,219 @@
+import type { FaqEntry } from './contact-content'
+import {
+  beatIndex,
+  clipDuration,
+  clock,
+  progressAt,
+  transportAt,
+  typedAt,
+} from './scene-logic'
+
+/**
+ * The scene launcher's playback machine: the clock, the queue, the playhead.
+ *
+ * It is a plain module and not part of the component for two reasons. It owns a
+ * `requestAnimationFrame` loop, a timer's worth of mutable state and a set of
+ * DOM writes, and none of that belongs in a render function, where it would
+ * have to be fenced off from React's rules one line at a time. And it makes the
+ * contract plain: React says *what happened* (a press, a stop, the unit
+ * arriving on screen); the engine says *what changed* (a view to render); the
+ * per-frame work, which is most of the work, never touches React at all.
+ *
+ * ## What a frame does
+ *
+ * Three things and nothing else. It advances the beat (a `data-beat` on the
+ * unit, which the stylesheet turns into LED and pulse animation); it launches a
+ * queued clip if a beat boundary has just passed, which is the whole of "a clip
+ * starts on the next beat"; and it advances a playing clip (a `--p` custom
+ * property on the clip and the master, the typed text, the clock). The first
+ * two are single attribute writes. The last is a few property writes on small
+ * subtrees. State is committed to React only on a transition.
+ *
+ * The loop runs while the unit is on screen or something is playing or queued,
+ * and stops otherwise, so an idle page costs nothing.
+ */
+
+export type EngineView = {
+  /** The clip whose answer is on the screen. */
+  selected: number | null
+  playing: number | null
+  queued: number | null
+  played: number[]
+}
+
+export type EngineDeps = {
+  items: readonly FaqEntry[]
+  /** Commit a transition to React. */
+  setView: (update: (view: EngineView) => EngineView) => void
+  /** Read live, so a change to the user's preference applies at once. */
+  reduced: () => boolean
+  els: {
+    unit: () => HTMLElement | null
+    master: () => HTMLElement | null
+    typed: () => HTMLElement | null
+    time: () => HTMLElement | null
+    bar: () => HTMLElement | null
+    clip: (index: number) => HTMLElement | null
+  }
+}
+
+export type Engine = {
+  launch: (index: number, immediate?: boolean) => void
+  stop: () => void
+  setAuto: (on: boolean) => void
+  setVisible: (on: boolean) => void
+  touched: () => boolean
+  destroy: () => void
+}
+
+export function createEngine(deps: EngineDeps): Engine {
+  const { items, els } = deps
+  let playing: number | null = null
+  let queued: number | null = null
+  let startAt = 0
+  let duration = 0
+  let lastBeat = -1
+  let visible = false
+  let running = false
+  let raf = 0
+  let touched = false
+  let auto = false
+  let destroyed = false
+
+  const writeProgress = (index: number | null, p: number) => {
+    els.master()?.style.setProperty('--p', String(p))
+    if (index !== null) els.clip(index)?.style.setProperty('--p', String(p))
+  }
+
+  const showWhole = (index: number) => {
+    const typed = els.typed()
+    if (typed) typed.textContent = items[index].answer
+    writeProgress(index, 1)
+  }
+
+  const finish = (index: number, advance: boolean) => {
+    playing = null
+    showWhole(index)
+    els.clip(index)?.style.setProperty('--p', '0')
+    const time = els.time()
+    if (time) time.textContent = '00:00 / 00:00'
+    deps.setView((view) => ({
+      ...view,
+      playing: null,
+      played: view.played.includes(index)
+        ? view.played
+        : [...view.played, index],
+    }))
+    if (advance && auto) {
+      const following = (index + 1) % items.length
+      queued = following
+      lastBeat = beatIndex(performance.now())
+      deps.setView((view) => ({ ...view, queued: following }))
+    }
+  }
+
+  const start = (index: number, now: number) => {
+    if (playing !== null && playing !== index) {
+      els.clip(playing)?.style.setProperty('--p', '0')
+    }
+    queued = null
+    playing = index
+    startAt = now
+    duration = clipDuration(items[index].answer)
+    const typed = els.typed()
+    if (typed) typed.textContent = ''
+    writeProgress(index, 0)
+    const time = els.time()
+    if (time) time.textContent = `00:00 / ${clock(duration)}`
+    deps.setView((view) => ({
+      ...view,
+      selected: index,
+      playing: index,
+      queued: null,
+    }))
+  }
+
+  const tick = (now: number) => {
+    raf = 0
+    running = false
+    if (destroyed) return
+
+    const beat = beatIndex(now)
+    if (beat !== lastBeat) {
+      lastBeat = beat
+      els.unit()?.setAttribute('data-beat', String(beat % 4))
+      // A queued clip launches on the beat, not on the press.
+      if (queued !== null) start(queued, now)
+      const bar = els.bar()
+      if (playing !== null && bar) bar.textContent = transportAt(now - startAt)
+    }
+
+    if (playing !== null) {
+      const elapsed = now - startAt
+      const p = progressAt(elapsed, duration)
+      writeProgress(playing, p)
+      const typed = els.typed()
+      if (typed) typed.textContent = typedAt(items[playing].answer, p)
+      const time = els.time()
+      if (time) time.textContent = `${clock(elapsed)} / ${clock(duration)}`
+      if (p >= 1) finish(playing, true)
+    }
+
+    if (visible || playing !== null || queued !== null) ensureLoop()
+  }
+
+  const ensureLoop = () => {
+    if (running || destroyed || deps.reduced()) return
+    running = true
+    raf = requestAnimationFrame(tick)
+  }
+
+  return {
+    launch(index, immediate = false) {
+      touched = true
+      if (deps.reduced()) {
+        // No loop with reduced motion: a press selects the clip and the whole
+        // answer appears at once.
+        playing = null
+        queued = null
+        deps.setView((view) => ({
+          ...view,
+          selected: index,
+          playing: null,
+          queued: null,
+        }))
+        showWhole(index)
+        return
+      }
+      if (immediate) {
+        start(index, performance.now())
+      } else {
+        queued = index
+        lastBeat = beatIndex(performance.now())
+        deps.setView((view) => ({ ...view, selected: index, queued: index }))
+      }
+      ensureLoop()
+    },
+    stop() {
+      touched = true
+      if (queued !== null) {
+        queued = null
+        deps.setView((view) => ({ ...view, queued: null }))
+      }
+      if (playing !== null) finish(playing, false)
+    },
+    setAuto(on) {
+      auto = on
+    },
+    setVisible(on) {
+      visible = on
+      if (on) ensureLoop()
+    },
+    touched: () => touched,
+    destroy() {
+      destroyed = true
+      cancelAnimationFrame(raf)
+      running = false
+    },
+  }
+}
diff --git a/features/landing-page/rack-01/contact-desk/scene-launch.module.css b/features/landing-page/rack-01/contact-desk/scene-launch.module.css
new file mode 100644
index 0000000..202d972
--- /dev/null
+++ b/features/landing-page/rack-01/contact-desk/scene-launch.module.css
@@ -0,0 +1,749 @@
+/* ── The scene launcher ──────────────────────────────────────
+   The FAQ, as a second unit on the same desk as the performance controller. It
+   wears the controller's own materials so the two read as one family of
+   hardware: the graphite chassis and its inset highlights, the green-phosphor
+   LCD with its scanlines, the pad colours, the same mono silkscreen, and the
+   same 780px width, so the eye finds one column down the page and not two.
+
+   Everything that moves is a transform, an opacity, a filter or a custom
+   property on a small subtree; nothing animates layout. The beat is a
+   `data-beat` on the unit, set by one rAF loop, and every pulse below is CSS
+   keyed off it, in pairs (A on even beats, B on odd) because an animation does
+   not restart when only a selector changes unless its name does.
+
+   Motion is behind `prefers-reduced-motion: no-preference`. With it off a press
+   selects a clip and its whole answer appears; nothing pulses, sweeps or types. */
+
+.srOnly {
+  position: absolute;
+  overflow: hidden;
+  width: 1px;
+  height: 1px;
+  clip-path: inset(50%);
+  white-space: nowrap;
+}
+
+.unit {
+  --lcd: var(--lcd-green, #5cd6a3);
+  --mono: var(--deck-font-mono, ui-monospace, monospace);
+  --ui: var(--deck-font-ui, sans-serif);
+  --ease: cubic-bezier(0.2, 0.7, 0.1, 1);
+  position: relative;
+  isolation: isolate;
+  width: min(780px, 100%);
+  margin: clamp(48px, 7vw, 96px) auto 0;
+  padding: clamp(18px, 3vw, 34px);
+  overflow: hidden;
+  border: 1px solid #090a09;
+  border-radius: 18px;
+  background: radial-gradient(
+      90% 70% at 8% 0,
+      rgb(255 255 255 / 0.12),
+      transparent 48%
+    ),
+    linear-gradient(145deg, #2b2d2b, #181a18);
+  box-shadow:
+    0 42px 70px rgb(29 30 28 / 0.28),
+    inset 0 1px rgb(255 255 255 / 0.13),
+    inset 0 -2px rgb(0 0 0 / 0.5);
+  color: #e9e6de;
+}
+.unit::before {
+  position: absolute;
+  z-index: -1;
+  inset: 10px;
+  border: 1px solid rgb(255 255 255 / 0.1);
+  border-radius: 11px;
+  content: '';
+  pointer-events: none;
+}
+/* The light on the chassis, following the pointer. */
+.sheen {
+  position: absolute;
+  z-index: -1;
+  inset: 0;
+  background: radial-gradient(
+    380px circle at var(--mx, 20%) var(--my, 0%),
+    rgb(255 255 255 / 0.07),
+    transparent 70%
+  );
+  pointer-events: none;
+}
+
+/* Arrival: the unit powers on, then its clips drop in along a diagonal. */
+.unit[data-reveal='armed'] {
+  opacity: 0;
+  transform: translate3d(0, 30px, 0) scale(0.985);
+}
+.unit[data-reveal='armed'] .clip {
+  opacity: 0;
+}
+.unit[data-reveal='in'] {
+  opacity: 1;
+  transform: none;
+}
+@media (prefers-reduced-motion: no-preference) {
+  .unit[data-reveal='in'] {
+    transition:
+      opacity 0.8s var(--ease),
+      transform 0.8s var(--ease);
+  }
+  .unit[data-reveal='in'] .clip {
+    animation: clipIn 0.6s var(--ease) backwards;
+    animation-delay: calc(var(--n) * 55ms + 300ms);
+  }
+  .unit[data-reveal='in'] .master {
+    animation: power 0.9s steps(1, end) 0.15s backwards;
+  }
+}
+@media (prefers-reduced-motion: reduce) {
+  .unit[data-reveal='armed'],
+  .unit[data-reveal='armed'] .clip {
+    opacity: 1;
+    transform: none;
+  }
+}
+@keyframes clipIn {
+  from {
+    opacity: 0;
+    transform: translateY(16px) scale(0.96);
+  }
+}
+@keyframes power {
+  0% {
+    filter: brightness(0.2);
+  }
+  18% {
+    filter: brightness(1.7);
+  }
+  30% {
+    filter: brightness(0.5);
+  }
+  46% {
+    filter: brightness(1.4);
+  }
+  100% {
+    filter: none;
+  }
+}
+
+/* ── Brand bar and transport ── */
+.brand {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: flex-start;
+  justify-content: space-between;
+  gap: 14px 20px;
+  margin-bottom: 20px;
+  padding-bottom: 14px;
+  border-bottom: 1px solid rgb(255 255 255 / 0.28);
+  color: #e9e6de;
+  font-family: var(--mono);
+  text-transform: uppercase;
+}
+.brand > div:first-child {
+  display: flex;
+  flex-direction: column;
+  gap: 3px;
+}
+.brand strong {
+  font-size: 14px;
+  letter-spacing: 0.08em;
+}
+.brand span {
+  color: rgb(219 224 216 / 0.58);
+  font-size: 8px;
+  letter-spacing: 0.12em;
+}
+.transport {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  gap: 8px;
+}
+.readout {
+  padding: 8px 10px;
+  border: 1px solid #060806;
+  border-radius: 4px;
+  background: #09130e;
+  box-shadow: inset 0 0 12px rgb(0 0 0 / 0.8);
+  color: var(--lcd);
+  font: 700 10px var(--mono);
+  letter-spacing: 0.1em;
+  font-variant-numeric: tabular-nums;
+}
+.readout b {
+  font-weight: 700;
+}
+.key {
+  display: inline-flex;
+  align-items: center;
+  gap: 8px;
+  min-height: 44px;
+  padding: 0 16px;
+  border: 1px solid #060806;
+  border-radius: 6px;
+  background: linear-gradient(180deg, #3b3e3a, #262825);
+  box-shadow:
+    0 3px 0 #0b0c0b,
+    inset 0 1px rgb(255 255 255 / 0.14);
+  color: #e9e6de;
+  cursor: pointer;
+  font: 700 10px var(--mono);
+  letter-spacing: 0.16em;
+  text-transform: uppercase;
+}
+.key:active {
+  transform: translateY(2px);
+  box-shadow: 0 1px 0 #0b0c0b;
+}
+.key[aria-pressed='true'] {
+  border-color: var(--lcd);
+  color: var(--lcd);
+  box-shadow:
+    0 3px 0 #0b0c0b,
+    0 0 14px rgb(92 214 163 / 0.3);
+}
+.stopIcon {
+  width: 9px;
+  height: 9px;
+  background: currentColor;
+}
+.key:focus-visible,
+.tools button:focus-visible,
+.clip:focus-visible,
+.cta:focus-visible {
+  outline: 2px solid var(--c, var(--lcd));
+  outline-offset: 2px;
+}
+
+/* ── The master: green-phosphor glass ── */
+.master {
+  --c: var(--lcd);
+  position: relative;
+  display: grid;
+  gap: 12px;
+  min-height: 268px;
+  padding: 16px 20px 14px;
+  overflow: hidden;
+  border: 1px solid rgb(255 255 255 / 0.28);
+  border-radius: 8px;
+  background:
+    linear-gradient(rgb(92 214 163 / 0.035) 1px, transparent 1px) 0 0 / 100% 5px,
+    #09130e;
+  box-shadow:
+    inset 0 0 22px rgb(0 0 0 / 0.9),
+    0 1px rgb(255 255 255 / 0.08);
+  color: var(--lcd);
+}
+/* A glow behind the glass that breathes on the beat while a clip plays. */
+.master::before {
+  position: absolute;
+  inset: 0;
+  background: radial-gradient(
+    70% 80% at 50% 100%,
+    color-mix(in srgb, var(--c) 22%, transparent),
+    transparent 70%
+  );
+  content: '';
+  opacity: 0;
+  pointer-events: none;
+  transition: opacity 0.4s ease;
+}
+.master[data-state='playing']::before {
+  opacity: 1;
+}
+.masterTop {
+  display: flex;
+  justify-content: space-between;
+  gap: 12px;
+  color: color-mix(in srgb, var(--c) 82%, transparent);
+  font: 700 9px var(--mono);
+  letter-spacing: 0.12em;
+  text-transform: uppercase;
+  font-variant-numeric: tabular-nums;
+}
+.live {
+  display: grid;
+}
+.question {
+  margin: 0;
+  color: var(--c);
+  font: 650 clamp(20px, 3.2vw, 30px) / 1.05 var(--ui);
+  letter-spacing: -0.035em;
+  text-transform: uppercase;
+  text-wrap: balance;
+}
+.master[data-state='queued'] .question {
+  animation: cue 0.5s steps(1, end) infinite;
+}
+.answer {
+  align-self: start;
+  min-height: 5.1em;
+  max-width: 62ch;
+  margin: 0;
+  color: color-mix(in srgb, var(--c) 78%, #e9e6de);
+  font: 500 12.5px / 1.7 var(--mono);
+}
+.caret {
+  display: inline-block;
+  width: 0.55em;
+  height: 1em;
+  margin-left: 2px;
+  background: var(--c);
+  vertical-align: text-bottom;
+  opacity: 0;
+}
+.master[data-state='playing'] .caret,
+.master[data-state='idle'] .caret {
+  opacity: 1;
+}
+@media (prefers-reduced-motion: no-preference) {
+  .master[data-state='playing'] .caret,
+  .master[data-state='idle'] .caret {
+    animation: blink 1s steps(1) infinite;
+  }
+}
+@keyframes blink {
+  50% {
+    opacity: 0;
+  }
+}
+@keyframes cue {
+  50% {
+    opacity: 0.35;
+  }
+}
+
+/* The master's waveform: the whole clip, lit up to the playhead. */
+.masterWave {
+  position: relative;
+  height: 64px;
+  --p: 0;
+}
+.playhead {
+  position: absolute;
+  top: -4px;
+  bottom: -4px;
+  left: calc(var(--p, 0) * 100%);
+  width: 2px;
+  background: #e9e6de;
+  box-shadow: 0 0 12px var(--c);
+  opacity: 0;
+}
+.master[data-state='playing'] .playhead {
+  opacity: 1;
+}
+.wave {
+  position: relative;
+  display: block;
+  width: 100%;
+  height: 100%;
+}
+.waveBase,
+.waveLit {
+  position: absolute;
+  inset: 0;
+  display: flex;
+  align-items: center;
+  gap: 2px;
+}
+.waveLit {
+  clip-path: inset(0 calc(100% - var(--p, 0) * 100%) 0 0);
+}
+.wave i {
+  flex: 1;
+  height: calc(var(--h) * 100%);
+  min-width: 1px;
+  border-radius: 1px;
+  background: rgb(233 230 222 / 0.2);
+  transform-origin: center;
+}
+.waveLit i {
+  background: var(--c);
+}
+@media (prefers-reduced-motion: no-preference) {
+  .master[data-state='playing'] .waveLit i {
+    animation: bob 0.62s ease-in-out infinite alternate;
+    animation-delay: calc(var(--b) * -0.045s);
+  }
+  .master[data-state='idle'] .waveBase i {
+    animation: idle 2.6s ease-in-out infinite alternate;
+    animation-delay: calc(var(--b) * -0.07s);
+  }
+}
+@keyframes bob {
+  from {
+    transform: scaleY(0.55);
+  }
+  to {
+    transform: scaleY(1.08);
+  }
+}
+@keyframes idle {
+  from {
+    transform: scaleY(0.4);
+  }
+  to {
+    transform: scaleY(0.85);
+  }
+}
+.tools {
+  display: flex;
+  justify-content: flex-end;
+  gap: 18px;
+}
+.tools button {
+  min-height: 32px;
+  padding: 0;
+  border: 0;
+  background: none;
+  color: var(--c);
+  cursor: pointer;
+  font: 700 9px var(--mono);
+  letter-spacing: 0.14em;
+  text-decoration: underline;
+  text-underline-offset: 3px;
+  text-transform: uppercase;
+}
+.tools button:disabled {
+  cursor: default;
+  opacity: 0.4;
+  text-decoration: none;
+}
+
+/* ── Tracks and clips ── */
+.tracks {
+  display: grid;
+  grid-template-columns: repeat(3, minmax(0, 1fr));
+  gap: 12px;
+  margin-top: 16px;
+}
+.track {
+  display: grid;
+  align-content: start;
+  gap: 8px;
+  min-width: 0;
+}
+.trackHead {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  padding: 0 2px 2px;
+  color: #8f938d;
+  font: 700 9px var(--mono);
+  letter-spacing: 0.14em;
+  text-transform: uppercase;
+}
+.trackHead i {
+  width: 8px;
+  height: 8px;
+  border-radius: 50%;
+  background: var(--c);
+  box-shadow: 0 0 8px var(--c);
+}
+.trackHead span {
+  flex: 1;
+  color: #e9e6de;
+}
+
+.clip {
+  position: relative;
+  display: grid;
+  align-content: space-between;
+  gap: 8px;
+  min-height: 112px;
+  padding: 10px 12px 11px;
+  overflow: hidden;
+  border: 1px solid #060806;
+  border-radius: 8px;
+  background: linear-gradient(180deg, #343731, #232522);
+  box-shadow:
+    0 3px 0 #0b0c0b,
+    inset 0 1px rgb(255 255 255 / 0.12);
+  color: #e9e6de;
+  cursor: pointer;
+  text-align: left;
+  transition:
+    transform 0.14s ease,
+    box-shadow 0.14s ease,
+    border-color 0.2s ease;
+}
+.clip::before {
+  position: absolute;
+  top: 0;
+  right: 0;
+  left: 0;
+  height: 3px;
+  background: var(--c);
+  content: '';
+  opacity: 0.85;
+}
+.clip:hover {
+  transform: translateY(-1px);
+  border-color: color-mix(in srgb, var(--c) 60%, #060806);
+}
+.clip:active {
+  transform: translateY(2px);
+  box-shadow: 0 1px 0 #0b0c0b;
+}
+.clip[data-selected='true'] {
+  border-color: var(--c);
+}
+/* The playhead's trail: a translucent wash, not an opaque fill, so the title
+   stays readable on both sides of the line. */
+.clipFill {
+  position: absolute;
+  inset: 0;
+  background: color-mix(in srgb, var(--c) 34%, transparent);
+  box-shadow: inset -2px 0 0 var(--c);
+  opacity: 0;
+  transform: scaleX(var(--p, 0));
+  transform-origin: left;
+  pointer-events: none;
+}
+.clip[data-state='playing'] .clipFill {
+  opacity: 1;
+}
+.clipHead {
+  position: relative;
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  color: #8f938d;
+  font: 700 9px var(--mono);
+  letter-spacing: 0.14em;
+}
+.clipHead b {
+  font-weight: 700;
+}
+.clipTitle {
+  position: relative;
+  font: 600 13.5px / 1.25 var(--ui);
+  letter-spacing: -0.01em;
+  text-wrap: balance;
+}
+.clip .wave {
+  position: relative;
+  height: 22px;
+}
+.clip .waveLit i {
+  background: var(--c);
+}
+
+/* The clip's icon: a play triangle, blinking when queued, bars when playing,
+   a dot once it has been played. */
+.clipIcon {
+  position: relative;
+  display: block;
+  width: 12px;
+  height: 12px;
+}
+.clipIcon::before {
+  position: absolute;
+  inset: 0;
+  background: currentColor;
+  clip-path: polygon(14% 6%, 14% 94%, 94% 50%);
+  content: '';
+}
+.clip[data-state='queued'] .clipIcon {
+  color: var(--c);
+}
+.clip[data-state='playing'] .clipIcon {
+  color: var(--c);
+}
+.clip[data-state='playing'] .clipIcon::before {
+  clip-path: polygon(
+    0 100%,
+    0 30%,
+    28% 30%,
+    28% 100%,
+    36% 100%,
+    36% 0,
+    64% 0,
+    64% 100%,
+    72% 100%,
+    72% 55%,
+    100% 55%,
+    100% 100%
+  );
+}
+.clip[data-state='played'] .clipIcon {
+  color: var(--c);
+  opacity: 0.7;
+}
+.clip[data-state='played'] .clipIcon::before {
+  clip-path: circle(28% at 50% 50%);
+}
+.clip[data-state='queued'] {
+  border-color: var(--c);
+}
+@media (prefers-reduced-motion: no-preference) {
+  .clip[data-state='queued'] {
+    animation: queued 0.5s steps(1, end) infinite;
+  }
+  .clip[data-state='queued'] .clipIcon {
+    animation: cue 0.5s steps(1, end) infinite;
+  }
+  /* On the beat: the playing clip kicks. Pairs, because a changing selector
+     alone does not restart an animation; a changing name does. */
+  .unit[data-beat='0'] .clip[data-state='playing'],
+  .unit[data-beat='2'] .clip[data-state='playing'] {
+    animation: kickA 0.48s ease-out;
+  }
+  .unit[data-beat='1'] .clip[data-state='playing'],
+  .unit[data-beat='3'] .clip[data-state='playing'] {
+    animation: kickB 0.48s ease-out;
+  }
+  .unit[data-beat='0'] .master[data-state='playing']::before,
+  .unit[data-beat='2'] .master[data-state='playing']::before {
+    animation: glowA 0.48s ease-out;
+  }
+  .unit[data-beat='1'] .master[data-state='playing']::before,
+  .unit[data-beat='3'] .master[data-state='playing']::before {
+    animation: glowB 0.48s ease-out;
+  }
+  .clip .waveLit i {
+    transform-origin: center;
+  }
+}
+@keyframes queued {
+  50% {
+    background: linear-gradient(180deg, #4b4e48, #34362f);
+  }
+}
+@keyframes kickA {
+  from {
+    filter: brightness(1.45);
+    transform: scale(1.025);
+  }
+}
+@keyframes kickB {
+  from {
+    filter: brightness(1.45);
+    transform: scale(1.025);
+  }
+}
+@keyframes glowA {
+  from {
+    opacity: 1;
+    filter: brightness(1.8);
+  }
+}
+@keyframes glowB {
+  from {
+    opacity: 1;
+    filter: brightness(1.8);
+  }
+}
+
+/* ── Footer ── */
+.foot {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  gap: 12px 18px;
+  margin-top: 18px;
+  padding-top: 14px;
+  border-top: 1px solid rgb(255 255 255 / 0.18);
+}
+.leds {
+  display: flex;
+  gap: 6px;
+}
+.leds i {
+  width: 8px;
+  height: 8px;
+  border-radius: 50%;
+  background: #1a1c1a;
+  box-shadow: inset 0 1px 2px #000;
+  transition: background 0.1s ease;
+}
+.unit[data-beat='0'] .leds i:nth-child(1),
+.unit[data-beat='1'] .leds i:nth-child(2),
+.unit[data-beat='2'] .leds i:nth-child(3),
+.unit[data-beat='3'] .leds i:nth-child(4) {
+  background: var(--lcd);
+  box-shadow:
+    0 0 10px var(--lcd),
+    inset 0 1px 2px rgb(255 255 255 / 0.5);
+}
+.foot p {
+  flex: 1;
+  min-width: 180px;
+  margin: 0;
+  color: #8f938d;
+  font: 700 9px var(--mono);
+  letter-spacing: 0.12em;
+  text-transform: uppercase;
+}
+.cta {
+  display: inline-flex;
+  align-items: center;
+  min-height: 44px;
+  padding: 0 18px;
+  border: 1px solid rgb(233 230 222 / 0.5);
+  border-radius: 999px;
+  color: #e9e6de;
+  font: 700 10px var(--mono);
+  letter-spacing: 0.14em;
+  text-decoration: none;
+  text-transform: uppercase;
+  transition:
+    background 0.2s ease,
+    color 0.2s ease,
+    border-color 0.2s ease;
+}
+.cta:hover {
+  border-color: var(--lcd);
+  background: var(--lcd);
+  color: #07140d;
+}
+
+/* Without a script the whole FAQ is plain text on the chassis. */
+.plain {
+  display: grid;
+  gap: 18px;
+  margin: 0;
+}
+.plain dt {
+  font: 650 18px / 1.2 var(--ui);
+  text-transform: uppercase;
+}
+.plain dd {
+  margin: 6px 0 0;
+  color: rgb(233 230 222 / 0.8);
+  font: 500 14px / 1.6 var(--ui);
+}
+
+/* ── Narrow screens: tracks stack, the master stays on top ── */
+@media (max-width: 700px) {
+  .tracks {
+    grid-template-columns: minmax(0, 1fr);
+    gap: 18px;
+  }
+  .clip {
+    min-height: 92px;
+  }
+  .master {
+    min-height: 300px;
+  }
+}
+@media (max-width: 460px) {
+  .transport {
+    width: 100%;
+  }
+  .key {
+    flex: 1;
+    justify-content: center;
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .clip,
+  .master::before,
+  .leds i,
+  .cta {
+    transition: none;
+  }
+}
diff --git a/features/landing-page/rack-01/contact-desk/scene-launch.tsx b/features/landing-page/rack-01/contact-desk/scene-launch.tsx
