+    const out = scrambleAt(TIMECODE, 0, 11)
+    for (let i = 0; i < TIMECODE.length; i += 1) {
+      if (/[0-9]/.test(TIMECODE[i])) expect(out[i]).toMatch(/[0-9]/)
