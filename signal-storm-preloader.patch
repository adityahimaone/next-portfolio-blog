+              </g>
+            )
+          }),
+        )}
+      </svg>
+    </div>
+  )
+}
+
+/** One reel: the letter, with decoy glyphs stacked above it, rolled up into the
+ *  window. Invisible until its own start, so letters arrive rather than wait. */
+function LetterCell({
+  cell,
+  index,
+  delay,
+}: {
+  cell: Cell
+  index: number
+  delay: number
+}) {
+  const pad = cell.s
+  const pitch = cell.h + cell.s * 2 + 24
+  const n = cell.giant ? 14 : 10
