+function StormRow({
+  row,
+  minSpan,
+  paper,
+}: {
+  row: number
+  minSpan: number
+  paper: string
+}) {
+  const { glyphs, span, tone } = useMemo(
+    () => stormRow(row, minSpan),
+    [row, minSpan],
+  )
+  const dir = row % 2 ? 'r' : 'l'
+  return (
+    <div
+      className={s.srow}
+      data-dir={dir}
+      style={{ '--row': row } as CSSProperties}
+    >
+      <svg
+        className={s.strip}
+        data-dir={dir}
+        viewBox={`0 -6 ${span * 2} 152`}
+        style={{ animationDuration: `${4.6 + (row % 3) * 1.5}s` }}
+        fill="none"
+        strokeLinecap="square"
