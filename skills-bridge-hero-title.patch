+'use client'
+
+import { Fragment, useRef, type CSSProperties } from 'react'
+
+import { MIXER_DATA } from '../../constants'
+import { Device } from '../bench/bench-device-layer'
+import { BRIDGE_DEVICES, BRIDGE_SLOT_Y } from './skills-bridge-frame'
+import styles from './skills-bridge.module.css'
+import { useSkillsBridge } from './use-skills-bridge'
+
+const STATEMENT = 'Every rule needs an instrument.'
+const STATEMENT_WORDS = STATEMENT.split(' ')
+
+/** Slot x, % of the stage. The docks in `skills-bridge-frame.ts` match these. */
+const SLOT_X = [20, 50, 80] as const
+
+/** How many channel names a slot prints before it says how many more. */
+const SHOWN = 4
+
+/**
+ * The bridge between the About and the Skills.
+ *
+ * ## What it is
+ *
+ * A pinned scene. On the About's own sheet a sentence arrives and three
+ * devices fly in; the Skills' room opens from the middle of the sheet like an
+ * iris; the devices dock into three rack slots labelled with the three groups
+ * of the stack; cables run out of the bottom of the scene. See
+ * `skills-bridge-frame.ts` for why those three devices and those three slots.
+ *
+ * ## What the DOM guarantees
+ *
+ * The slots (group names and the technologies in them) are real text in
+ * ordinary flow, so the section says the same thing with the script absent,
+ * with reduced motion, and on a phone, where it is a static composition: the
+ * sentence, three devices, three labelled slots. The devices, cables and
+ * caption are decoration and `aria-hidden`.
+ *
+ * Nothing in the DOM here is positioned by the script except transforms and
+ * custom properties; see `use-skills-bridge.ts`.
+ */
+export function SkillsBridge() {
+  const root = useRef<HTMLElement>(null)
+  useSkillsBridge(root)
+
+  return (
+    <section
+      ref={root}
+      className={styles.bridge}
+      aria-label="From practice to toolkit"
+    >
+      <div className={styles.stage} data-bridge-stage>
+        <div className={styles.sheet}>
+          <p
+            className={styles.statement}
+            data-bridge-statement
+            style={{ '--n': STATEMENT_WORDS.length } as CSSProperties}
+          >
+            {STATEMENT_WORDS.map((word, index) => (
+              <Fragment key={`${word}-${index}`}>
+                <span className={styles.sw}>
+                  <span
+                    className={styles.swIn}
+                    style={{ '--i': index } as CSSProperties}
+                  >
+                    {word}
+                  </span>
+                </span>{' '}
+              </Fragment>
+            ))}
+          </p>
+        </div>
+
+        <div className={styles.room} data-bridge-room>
+          <div className={styles.rack} data-bridge-rack>
+            {MIXER_DATA.map((group, index) => (
+              <div
+                key={group.id}
+                className={styles.slot}
+                data-bridge-slot
+                style={
+                  {
+                    '--sx': `${SLOT_X[index]}%`,
+                    '--sy': `${BRIDGE_SLOT_Y}%`,
+                  } as CSSProperties
+                }
+              >
+                <div className={styles.slotHead}>
+                  <span className={styles.slotLabel}>{group.label}</span>
+                  <i className={styles.led} aria-hidden="true" />
+                </div>
+                <p className={styles.slotChannels}>
+                  {group.channels
+                    .slice(0, SHOWN)
+                    .map((channel) => channel.name)
+                    .join(' · ')}
+                  {group.channels.length > SHOWN
+                    ? ` · +${group.channels.length - SHOWN}`
+                    : ''}
+                </p>
+              </div>
+            ))}
+          </div>
+
+          <svg
+            className={styles.cables}
+            data-bridge-cables
+            viewBox="0 0 100 100"
+            preserveAspectRatio="none"
+            aria-hidden="true"
+          >
+            {CABLES.map((d, index) => (
+              <Fragment key={d}>
+                <path
+                  className={styles.cableGlow}
+                  d={d}
+                  pathLength={1}
+                  style={{
+                    strokeDashoffset: `calc(1 - var(--c${index}, 1))`,
+                  }}
+                />
+                <path
+                  className={styles.cable}
+                  d={d}
+                  pathLength={1}
+                  style={{
+                    strokeDashoffset: `calc(1 - var(--c${index}, 1))`,
+                  }}
+                />
+              </Fragment>
+            ))}
+          </svg>
+
+          <p className={styles.caption} data-bridge-caption aria-hidden="true">
+            03 / Toolkit <b>routing three devices to stack control</b>
+          </p>
+        </div>
+
+        <div className={styles.devices} data-bridge-devices aria-hidden="true">
+          {BRIDGE_DEVICES.map((spec) => (
+            <span
+              key={spec.id}
+              className={styles.anchor}
+              data-bridge-device={spec.id}
+            >
+              <span className={styles.bob}>
+                <span className={styles.rot} data-bridge-rot={spec.id}>
+                  <span className={styles.fit}>
+                    <Device kind={spec.id} />
+                  </span>
+                </span>
+              </span>
+            </span>
+          ))}
+        </div>
+      </div>
+    </section>
+  )
+}
+
+/**
+ * The cables, in the room's own 100 x 100 space (`preserveAspectRatio="none"`,
+ * with non-scaling strokes). Each leaves the bottom of its slot and the three
+ * meet on one bus that runs off the bottom of the scene, which is where the
+ * Skills' controller begins.
+ */
+const CABLES = [
+  `M${SLOT_X[0]} ${BRIDGE_SLOT_Y + 25} C${SLOT_X[0]} 88, 50 80, 50 101`,
+  `M${SLOT_X[1]} ${BRIDGE_SLOT_Y + 25} L50 101`,
+  `M${SLOT_X[2]} ${BRIDGE_SLOT_Y + 25} C${SLOT_X[2]} 88, 50 80, 50 101`,
+] as const
diff --git a/features/landing-page/components/bridge/use-skills-bridge.ts b/features/landing-page/components/bridge/use-skills-bridge.ts
new file mode 100644
index 0000000..661fa40
--- /dev/null
+++ b/features/landing-page/components/bridge/use-skills-bridge.ts
@@ -0,0 +1,198 @@
+'use client'
+
+import { useEffect, type RefObject } from 'react'
+
+import {
+  BRIDGE_DEVICES,
+  bridgeFrame,
+  type BridgeFrame,
+} from './skills-bridge-frame'
+
+/**
+ * The one media query the scene gates on, written out here and in
+ * `skills-bridge.module.css`: wide enough, tall enough, motion allowed. A
+ * viewport that fails any of them gets the static composition from both.
+ */
+const BRIDGE_QUERY =
+  '(min-width: 769px) and (min-height: 600px) and (prefers-reduced-motion: no-preference)'
+
+type Gsap = (typeof import('gsap'))['gsap']
+type ScrollTriggerStatic =
+  (typeof import('gsap/ScrollTrigger'))['ScrollTrigger']
+
+/**
+ * The bridge's motion: one pinned trigger, one pure frame, a handful of writes.
+ *
+ * The shape is the one `use-bench-motion.ts` established and it is kept on
+ * purpose. Dependencies are imported inside the activation path, so a phone or
+ * a reduced-motion visitor never pays for them. There is no ticker and no
+ * smoother here: the page's single Lenis instance owns the scroll position.
+ * Every write is a transform or a custom property on one small node, never on
+ * the section, so a scroll tick restyles a few nodes rather than the page.
+ * Everything written is unwritten on teardown, so a resize across the
+ * breakpoint leaves the static composition exactly as the stylesheet drew it.
+ */
+export function useSkillsBridge(root: RefObject<HTMLElement | null>) {
+  useEffect(() => {
+    const element = root.current
+    if (!element) return
+
+    const query = window.matchMedia(BRIDGE_QUERY)
+    let disposed = false
+    let token = 0
+    let teardown: (() => void) | null = null
+
+    const activate = async () => {
+      if (disposed || teardown) return
+      const mine = ++token
+
+      let gsap: Gsap
+      let ScrollTrigger: ScrollTriggerStatic
+      try {
+        ;[{ gsap }, { ScrollTrigger }] = await Promise.all([
+          import('gsap'),
+          import('gsap/ScrollTrigger'),
+        ])
+      } catch (error) {
+        console.error('Skills bridge: dependencies failed to load', error)
+        return
+      }
+      if (disposed || mine !== token || root.current !== element) return
+
+      gsap.registerPlugin(ScrollTrigger)
+      const stop = startBridge({ ScrollTrigger, element })
+      if (disposed || mine !== token || root.current !== element) {
+        stop()
+        return
+      }
+      teardown = stop
+    }
+
+    const sync = () => {
+      if (query.matches) {
+        void activate()
+        return
+      }
+      token += 1
+      teardown?.()
+      teardown = null
+    }
+
+    sync()
+    query.addEventListener('change', sync)
+
+    return () => {
+      disposed = true
+      token += 1
+      query.removeEventListener('change', sync)
+      teardown?.()
+      teardown = null
+    }
+  }, [root])
+}
+
+function startBridge({
+  ScrollTrigger,
+  element,
+}: {
+  ScrollTrigger: ScrollTriggerStatic
+  element: HTMLElement
+}): () => void {
+  const stage = element.querySelector<HTMLElement>('[data-bridge-stage]')
+  const statement = element.querySelector<HTMLElement>(
+    '[data-bridge-statement]',
+  )
+  const room = element.querySelector<HTMLElement>('[data-bridge-room]')
+  const rack = element.querySelector<HTMLElement>('[data-bridge-rack]')
+  const caption = element.querySelector<HTMLElement>('[data-bridge-caption]')
+  const cables = element.querySelector<SVGElement>('[data-bridge-cables]')
+  const slots = Array.from(
+    element.querySelectorAll<HTMLElement>('[data-bridge-slot]'),
+  )
+
+  const anchors: HTMLElement[] = []
+  const rots: HTMLElement[] = []
+  for (const device of BRIDGE_DEVICES) {
+    const anchor = element.querySelector<HTMLElement>(
+      `[data-bridge-device="${device.id}"]`,
+    )
+    const rot = element.querySelector<HTMLElement>(
+      `[data-bridge-rot="${device.id}"]`,
+    )
+    if (anchor) anchors.push(anchor)
+    if (rot) rots.push(rot)
+  }
+
+  if (
+    !stage ||
+    !statement ||
+    !room ||
+    !rack ||
+    !caption ||
+    !cables ||
+    slots.length !== BRIDGE_DEVICES.length ||
+    anchors.length !== BRIDGE_DEVICES.length ||
+    rots.length !== BRIDGE_DEVICES.length
+  ) {
+    console.error(
+      'Skills bridge: markup is incomplete; leaving the static flow',
+    )
+    return () => {}
+  }
+
+  let width = 1440
+  let height = 900
+  const measure = () => {
+    const box = stage.getBoundingClientRect()
+    width = box.width || 1440
+    height = box.height || 900
+  }
+
+  const render = (frame: BridgeFrame) => {
+    statement.style.setProperty('--s', String(frame.statement))
+    room.style.setProperty('--r', String(frame.iris))
+    rack.style.setProperty('--rack', String(frame.rack))
+    caption.style.setProperty('--k', String(frame.caption))
+
+    frame.devices.forEach((device, index) => {
+      anchors[index].style.transform =
+        `translate3d(${device.x}px, ${device.y}px, 0) scale(${device.scale})`
+      anchors[index].style.setProperty('--o', String(device.opacity))
+      rots[index].style.transform =
+        `rotateX(${device.rx}deg) rotateY(${device.ry}deg) rotateZ(${device.rz}deg)`
+      slots[index].style.setProperty('--lit', String(device.lit))
+      cables.style.setProperty(`--c${index}`, String(device.cable))
+    })
+  }
+
+  measure()
+  const trigger = ScrollTrigger.create({
+    trigger: element,
+    start: 'top top',
+    end: 'bottom bottom',
+    invalidateOnRefresh: true,
+    onRefreshInit: measure,
+    onRefresh: (self) => render(bridgeFrame(self.progress, width, height)),
+    onUpdate: (self) => render(bridgeFrame(self.progress, width, height)),
+  })
+  render(bridgeFrame(trigger.progress, width, height))
+
+  return () => {
+    trigger.kill()
+    statement.style.removeProperty('--s')
+    room.style.removeProperty('--r')
+    rack.style.removeProperty('--rack')
+    caption.style.removeProperty('--k')
+    anchors.forEach((anchor) => {
+      anchor.style.transform = ''
+      anchor.style.removeProperty('--o')
+    })
+    rots.forEach((rot) => {
+      rot.style.transform = ''
+    })
+    slots.forEach((slot) => slot.style.removeProperty('--lit'))
+    for (let index = 0; index < BRIDGE_DEVICES.length; index += 1) {
+      cables.style.removeProperty(`--c${index}`)
+    }
+  }
+}
