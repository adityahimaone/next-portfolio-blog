+    expect(bridgeFrame(BRIDGE_PHASES.arrive[1], 1440, 900).statement).toBe(1)
+  })
+
+  it('docks every device into its slot, face on and lit, at the end', () => {
+    const end = bridgeFrame(1, 1440, 900)
