+    transparent
+  );
+}
+.tickerTrack {
+  display: inline-flex;
+}
+.tickerRun {
+  display: inline-flex;
+  flex: none;
+}
+.tickerRun span {
+  padding: 0 0.9em;
+}
+.tickerRun span::after {
