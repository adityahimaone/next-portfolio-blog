+
+/* ═══ Slit type ═════════════════════════════════════════════
+   One headline treatment for the section's two titles. Each line clips its own
+   overflow; each capital sits below the baseline by `--cut` (set per title)
+   until the section arrives, and rises through the slit, a few milliseconds
+   behind the letter before it. Hovering lifts the letters clear, on pointer
+   devices only. Reduced motion sets the type whole. */
+
+.title {
+  margin: 0;
+  color: var(--panel-ink, #101211);
+  font-family: var(--deck-font-display, sans-serif);
+  font-size: clamp(30px, 7.6cqi, 104px);
+  font-weight: 800;
+  letter-spacing: -0.04em;
+  line-height: 0.88;
+  text-transform: uppercase;
+}
+.line {
+  display: block;
+  overflow: hidden;
+  padding-top: 0.06em;
+  margin-top: -0.06em;
+}
+.word {
+  display: inline-block;
+  white-space: nowrap;
+}
+.ch {
+  display: inline-block;
+  transform: translateY(var(--cut, 0px));
+  transition: transform 820ms cubic-bezier(0.22, 1, 0.36, 1);
+  transition-delay: min(calc(var(--i) * 26ms), 420ms);
+}
+.contactHead[data-intro='pending'] .ch,
+.faq[data-intro='pending'] .ch {
+  transform: translateY(104%);
+  transition: none;
+}
+@media (hover: hover) and (pointer: fine) {
+  .title[data-slit='true']:hover .ch {
+    transform: translateY(0);
+    transition-duration: 420ms;
+    transition-delay: min(calc(var(--i) * 14ms), 220ms);
+  }
+}
+@media (prefers-reduced-motion: reduce) {
+  .ch,
+  .contactHead[data-intro='pending'] .ch {
+    transform: translateY(var(--cut, 0px));
+    transition: none;
+  }
+}
+
+/* ── The Contact section's own title ── */
+.contactHead {
+  container-type: inline-size;
+  display: grid;
+  gap: clamp(14px, 2cqi, 24px);
+  width: 100%;
+  min-width: 0;
+}
+.eyebrow {
+  display: inline-flex;
+  align-items: center;
+  gap: 12px;
+  color: var(--panel-ink-muted, rgb(29 30 28 / 0.66));
+  font: 700 11px var(--deck-font-mono, ui-monospace, monospace);
+  letter-spacing: 0.22em;
+  text-transform: uppercase;
+}
+.eyebrow b {
+  color: var(--deck-orange, #ff5a1f);
+  font-weight: 700;
+}
+.eyebrow i {
+  width: 28px;
+  height: 0;
+  border-top: 1px solid currentColor;
+  opacity: 0.5;
+}
+
+/* ═══ The FAQ band ═════════════════════════════════════════
+   Full bleed, the hero's ground, and the one place in the section the page
+   goes dark. Type and rules are cream; the flood is the signal orange; text on
+   the flood is the ground colour, so an open row is a dark-on-orange inversion
+   of itself. The playhead is what makes the flood a sweep and not a wipe. */
+
+.faq {
+  --p: var(--deck-ground, #14171a);
+  --k: var(--deck-ground-ink, #eee9df);
+  --f: var(--deck-orange, #ff5a1f);
+  --o: #14171a;
+  --in: 460ms;
+  --out: 300ms;
+  --ease-flood: cubic-bezier(0.76, 0, 0.24, 1);
+  --ease-out: cubic-bezier(0.22, 1, 0.36, 1);
+  position: relative;
+  z-index: 2;
+  width: 100vw;
+  margin: clamp(56px, 8vw, 120px) 0 0 calc(50% - 50vw);
+  overflow: hidden;
+  isolation: isolate;
+  background:
+    linear-gradient(180deg, transparent 70%, #0b0d0c),
+    linear-gradient(
+        90deg,
+        var(--deck-grid-line, rgb(238 233 223 / 0.05)) 1px,
+        transparent 1px
+      )
+      0 0 / var(--deck-grid-cell, 30px) var(--deck-grid-cell, 30px),
+    var(--p);
+  color: var(--k);
+  border-top: 1px solid var(--deck-hair, rgb(238 233 223 / 0.13));
+}
+.faq ::selection {
+  background: var(--f);
+  color: var(--o);
+}
+.faqInner {
+  /* The gutter is the distance from the band's edge to the content. It is in
+     viewport units on purpose: the flood, its playhead and the dark copy of a
+     row all reach out by exactly this much, so on a wide screen (where the
+     content is capped and centred) the orange still runs edge to edge. */
+  --gutter: max(clamp(16px, 4vw, 64px), calc((100vw - 1320px) / 2));
+  container-type: inline-size;
+  width: 100%;
+  padding: clamp(56px, 8vw, 112px) var(--gutter) clamp(48px, 6vw, 88px);
+}
+.faq .title {
+  color: var(--k);
+}
+.faq .title {
+  font-size: clamp(30px, 8.6cqi, 140px);
+}
+
+.kicker {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  margin-bottom: clamp(18px, 2.4cqi, 32px);
+  color: var(--deck-ground-muted, #8e928e);
+  font: 700 11px var(--deck-font-mono, ui-monospace, monospace);
+  letter-spacing: 0.22em;
+  text-transform: uppercase;
+}
+.kicker span:first-child {
+  display: inline-flex;
+  align-items: center;
+  gap: 10px;
+  color: var(--k);
+}
+.kicker i {
+  width: 8px;
+  height: 8px;
+  border-radius: 50%;
+  background: var(--f);
+  box-shadow: 0 0 10px var(--f);
+}
+
+/* The ruler under the headline: bars, ticks, and the playhead's one sweep. */
+.ruler {
+  position: relative;
+  height: 46px;
+  margin-top: clamp(22px, 3cqi, 44px);
+  border-top: 1px solid var(--k);
+  background:
+    linear-gradient(90deg, var(--k) 1px, transparent 1px) 0 0 / calc(100% / 16)
+      14px repeat-x,
+    linear-gradient(90deg, var(--k) 1px, transparent 1px) 0 0 / calc(100% / 64)
+      6px repeat-x;
+  opacity: 0.9;
+}
+.ruler > span {
+  position: absolute;
+  top: 18px;
+  padding-left: 8px;
+  color: var(--k);
+  font: 700 10px var(--deck-font-mono, ui-monospace, monospace);
+  letter-spacing: 0.2em;
+}
+.sweep {
+  position: absolute;
+  inset: -1px 0 0;
+  overflow: hidden;
+  pointer-events: none;
+}
+.sweep i {
+  position: absolute;
+  inset: 0;
+  transform: translateX(-100%);
+  opacity: 0;
+}
+.sweep i::after {
+  position: absolute;
+  top: 0;
+  right: 0;
+  bottom: 0;
+  width: 2px;
+  background: var(--f);
+  box-shadow: 0 0 14px var(--f);
+  content: '';
+}
+.sweep i::before {
+  position: absolute;
+  top: 0;
+  right: -5px;
