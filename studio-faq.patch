+  }
+}
+@keyframes playhead {
+  0% {
+    opacity: 1;
+    transform: translateX(-100%);
+  }
+  92% {
+    opacity: 1;
+  }
+  100% {
+    opacity: 0;
+    transform: translateX(0);
+  }
+}
+
+/* The moving line. */
+.ticker {
+  display: flex;
+  align-items: center;
+  gap: 12px;
+  padding: 0.55em 0;
+  overflow: hidden;
+  border-bottom: 1px solid var(--k);
+  font-size: clamp(14px, 1.6cqi, 22px);
+  font-weight: 600;
+  letter-spacing: 0.04em;
+  text-transform: uppercase;
+  white-space: nowrap;
+}
+.tickerMask {
+  flex: 1;
+  min-width: 0;
+  overflow: hidden;
