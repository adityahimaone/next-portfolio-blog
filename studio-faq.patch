+
+/* The flood, the dark copy of the row, and the playhead that leads both. All
+   three share one duration and one curve, so the line is exactly on the edge. */
+.fill,
+.scan {
+  position: absolute;
+  top: -1px;
+  right: calc(var(--gutter) * -1);
+  bottom: 0;
+  left: calc(var(--gutter) * -1);
+  pointer-events: none;
+}
+.fill {
+  background: var(--f);
+  clip-path: inset(0 100% 0 0);
+}
+.item[data-state='open'] .fill {
+  clip-path: inset(0 0 0 0);
+  transition: clip-path var(--in) var(--ease-flood);
+}
+.item[data-state='closing'] .fill {
+  clip-path: inset(0 0 0 100%);
+  transition: clip-path var(--out) var(--ease-flood);
+}
+.scan {
+  z-index: 3;
+  opacity: 0;
+  transform: translateX(-100%);
+}
+.scan::before,
+.scan::after {
+  position: absolute;
+  top: 0;
+  bottom: 0;
+  width: 2px;
+  background: var(--k);
+  box-shadow: 0 0 16px 1px var(--f);
+  content: '';
+}
+.scan::after {
+  right: 0;
+}
+.scan::before {
+  left: 0;
+  opacity: 0;
+}
+.item[data-state='open'] .scan {
+  transform: translateX(0);
+  transition: transform var(--in) var(--ease-flood);
+}
+.item[data-state='closing'] .scan {
+  opacity: 1;
+  transform: translateX(100%);
+  transition: transform var(--out) var(--ease-flood);
+}
+.item[data-state='closing'] .scan::after {
+  opacity: 0;
+}
+.item[data-state='closing'] .scan::before {
+  opacity: 1;
+}
+/* While opening the line is visible; it fades once the flood has landed. */
+.item[data-state='open'] .scan {
+  animation: scanLife var(--in) linear both;
+}
+@keyframes scanLife {
+  0% {
+    opacity: 1;
+  }
+  96% {
+    opacity: 1;
+  }
+  100% {
+    opacity: 0;
+  }
+}
+
+/* The scrub line: where the pointer is along a closed row. */
+.item::after {
+  position: absolute;
+  top: 0;
+  bottom: 0;
+  left: var(--mx, -10px);
