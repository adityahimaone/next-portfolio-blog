+  gap: 18px;
+  padding: 0 0 clamp(24px, 2.8cqi, 40px);
+  color: var(--o);
+}
+.text {
+  max-width: 58ch;
+  margin: 0;
+  font: 500 clamp(17px, 1.45cqi, 21px) / 1.5 var(--deck-font-ui, sans-serif);
+  letter-spacing: -0.005em;
+  text-wrap: pretty;
+}
+.text .mark {
+  background: var(--o);
+  color: var(--f);
+}
+/* The answer's words settle in behind the playhead, a few milliseconds apart. */
+.w {
+  display: inline-block;
+}
+@media (prefers-reduced-motion: no-preference) {
+  .w {
+    opacity: 0;
+    transform: translateY(0.5em);
+  }
+  .item[data-state='open'] .w {
+    opacity: 1;
+    transform: none;
+    transition:
+      opacity 360ms ease,
+      transform 460ms var(--ease-out);
+    transition-delay: calc(var(--in) * 0.5 + var(--w) * 16ms);
+  }
+}
+.tools {
+  display: flex;
+  align-items: flex-start;
+  gap: 16px;
+  order: 1;
+  font: 700 12px var(--deck-font-mono, ui-monospace, monospace);
+  letter-spacing: 0.12em;
+  text-transform: uppercase;
+}
+.tag {
+  padding: 3px 10px;
+  border: 1.5px solid var(--o);
+  border-radius: 999px;
+  font-size: 11px;
+}
+.copy {
+  margin-top: -5px;
+  padding: 9px 0;
+  border: 0;
+  background: none;
+  color: var(--o);
+  cursor: pointer;
+  font: inherit;
+  text-decoration: underline;
+  text-underline-offset: 3px;
+}
+.empty .copy {
+  margin: 0;
+  color: var(--k);
+}
+@container (min-width: 760px) {
+  .answer {
+    grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr);
+    column-gap: 48px;
+    row-gap: 20px;
+    /* The answer sits in the right column, under the row's own label. */
+    padding-left: calc(4.6em + clamp(12px, 2cqi, 28px));
+  }
+  .text,
+  .tools {
+    grid-column: 2;
+  }
+}
+.empty {
+  padding: clamp(28px, 4cqi, 56px) 0;
+  border-top: 1px solid var(--k);
+}
+.empty p {
+  margin: 0 0 14px;
+  font: 800 clamp(20px, 2.1cqi, 32px) / 1.15
+    var(--deck-font-display, sans-serif);
+  letter-spacing: -0.02em;
+}
+
+.contact {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  justify-content: space-between;
+  gap: 20px 32px;
+  margin-top: clamp(36px, 5cqi, 72px);
+}
+.contact p {
+  margin: 0;
+  font: 800 clamp(22px, 2.6cqi, 40px) / 1.05
+    var(--deck-font-display, sans-serif);
+  letter-spacing: -0.03em;
+}
+.cta {
+  position: relative;
+  display: inline-flex;
+  min-height: 52px;
+  overflow: hidden;
+  border: 1.5px solid var(--k);
+  border-radius: 999px;
+  color: var(--k);
+  font: 800 clamp(13px, 1.2cqi, 16px)
+    var(--deck-font-mono, ui-monospace, monospace);
+  letter-spacing: 0.14em;
+  text-decoration: none;
+  text-transform: uppercase;
+  white-space: nowrap;
+  transition: transform 140ms ease;
+}
+.cta > span {
+  display: inline-flex;
+  align-items: center;
+  gap: 12px;
+  padding: 0 26px;
+}
+.cta > span + span {
+  position: absolute;
+  inset: 0;
+  background: var(--f);
+  color: var(--o);
+  clip-path: inset(0 100% 0 0);
+  transition: clip-path 360ms var(--ease-flood);
+}
+.cta svg {
+  width: 18px;
+  height: 18px;
+  transition: transform 360ms var(--ease-out);
+}
+.cta:hover > span + span,
+.cta:focus-visible > span + span {
+  clip-path: inset(0 0 0 0);
+}
+.cta:hover svg,
+.cta:focus-visible svg {
+  transform: translateX(4px);
+}
+.cta:active {
+  transform: scale(0.98);
+}
+
+/* Reduced motion is the complete alternative: states change, nothing sweeps. */
+@media (prefers-reduced-motion: reduce) {
+  .fill,
+  .rowInv,
+  .panel,
+  .plus,
+  .label,
+  .cell::before,
+  .cta > span + span,
+  .cta svg,
+  .item[data-state] .fill,
+  .item[data-state] .rowInv,
+  .item[data-state] .panel {
+    transition: none !important;
+  }
+  .scan {
+    display: none;
+  }
+  .btn:hover .label {
+    transform: none !important;
+  }
+}
