+    expect(ARRANGEMENT_FOLD[0]).toBeLessThan(ARRANGEMENT_PHASES.rail)
+    expect(ARRANGEMENT_FOLD[1]).toBeGreaterThan(ARRANGEMENT_PHASES.rail)
+    expect(ARRANGEMENT_FOLD[1]).toBeLessThanOrEqual(ARRANGEMENT_SEAM_OPEN)
+  })
+
