+/* The fold: the supporting lanes tuck behind the profile lane as the dive
+   lands. `--lane-dy` is the world-space distance from the lane's centre to the
+   profile lane's, measured once per refresh and written on the lane, so each
+   lane travels exactly as far as it has to whatever its height. It flattens as
+   it goes (never to nothing, so a hairline of it is the last thing seen) and
+   the profile lane is `z-index: 2` and brought forward, so the others pass
+   *behind* it rather than through it.
+
+   The same `translateZ` the lanes already carry is kept as the last term, so
+   the depth layer is unchanged; at `--arr-fold: 0` this resolves to exactly the
+   old `translateZ(...)`. Specificity is one class higher than `.laneGhost`'s so
+   the ghost tracks fold too — their depth is the supporting lanes', which is
+   the factor they fold at. */
+.lane:not(.laneProfile) {
+  transform: translate3d(
+      0,
+      calc(var(--lane-dy, 0px) * var(--arr-fold, 0)),
+      calc(var(--arr-depth) * -0.18)
+    )
+    scaleY(calc(1 - var(--arr-fold, 0) * 0.92));
+}
